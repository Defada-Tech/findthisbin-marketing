---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import {
  GET_API_KEY_LABEL,
  GET_API_KEY_URL,
  TALK_TO_SALES_LABEL,
  TALK_TO_SALES_URL,
} from "../lib/site";

const principles = [
  { n: "01", t: "Precision over guesswork", d: "If we’re not sure, we say so — with a confidence score on every field." },
  { n: "02", t: "Developer-first", d: "Great docs, clean SDKs, and a free tier. The integration should be the easy part." },
  { n: "03", t: "EU-resident by default", d: "Data hosted and processed in the EU — residency isn’t an upsell." },
  { n: "04", t: "Out of PCI scope", d: "We only ever touch the BIN — never a full card number, by design." },
];
---

<Layout
  title="FindThisBIN — Company"
  description="FindThisBIN exists to give payment platforms card intelligence they can underwrite — accurate, fast, and EU-resident by default."
  active="company"
>
  <!-- ============ HERO ============ -->
  <section class="band band-ink page-hero">
    <div class="page-hero-bg" aria-hidden="true"></div>
    <div class="wrap wrap-narrow page-hero-wrap">
      <span class="pill">
        <span class="dot" aria-hidden="true"></span>
        Company
      </span>
      <h1 class="h1-page hero-h1" data-reveal>
        Building the trust layer for <span class="grad-text">payments.</span>
      </h1>
      <p class="lead hero-lead" data-reveal>
        FindThisBIN exists to give payment platforms card intelligence they can
        underwrite — accurate, fast, and EU-resident by default.
      </p>
    </div>
  </section>

  <!-- ============ MISSION / STORY ============ -->
  <section class="band band-white">
    <div class="wrap wrap-narrow">
      <div class="mission-grid">
        <div data-reveal>
          <Eyebrow label="Why we exist" tone="violet" />
          <h2 class="h2 mission-h2">BIN data was stuck in the 6-digit era. Payments moved on.</h2>
        </div>
        <div class="mission-copy" data-reveal>
          <p>
            As card ranges migrated to 8 digits and EU regulation reshaped disclosure and DCC,
            the legacy BIN tables most providers still ship quietly fell out of date —
            mislabeling prepaid and commercial cards, guessing at issuer country, and ignoring
            residency entirely.
          </p>
          <p>
            We started FindThisBIN to fix that from first principles: true 8-digit precision,
            multi-source corrections, per-field confidence, and a sub-10ms API hosted entirely
            in the EU — built by people who have shipped payments infrastructure and know what a
            checkout hot path demands.
          </p>
          <p>
            Today that data powers routing, surcharging, DCC, checkout UX, and risk for modern
            payment platforms across the continent.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRINCIPLES ============ -->
  <section class="band band-off">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="What we value" tone="violet" />
        <h2 class="h2">Principles we build on.</h2>
      </div>
      <div class="principles" data-reveal>
        {
          principles.map((p) => (
            <article class="principle">
              <div class="principle-n">{p.n}</div>
              <h3 class="h3 principle-t">{p.t}</h3>
              <p class="principle-d">{p.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="final-blob" aria-hidden="true"></div>
    <div class="wrap wrap-tight final-wrap">
      <h2 class="h1-page final-h2" data-reveal>Build on card intelligence you can trust.</h2>
      <div class="cta-row center final-cta" data-reveal>
        <Button href={GET_API_KEY_URL} label={GET_API_KEY_LABEL} variant="primary" size="lg" />
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="ghost-dark" size="lg" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Section heads (shared rhythm with other pages) ───────────────── */
  .section-head { max-width: 640px; margin-bottom: 44px; }
  .section-head .h2 { margin-top: 14px; }
  .on-dark { color: #fff; }
  .lead.on-dark { color: var(--text-dark-body); }

  /* ── Page hero ────────────────────────────────────────────────────── */
  .page-hero { padding-bottom: clamp(48px, 6vw, 72px); }
  .page-hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 80% at 70% -10%, rgba(124, 92, 255, 0.26), transparent 55%),
      radial-gradient(60% 60% at 8% 10%, rgba(34, 211, 238, 0.13), transparent 52%);
  }
  .page-hero-wrap { z-index: 1; }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 24px;
    font-size: 13px;
    font-weight: 600;
    color: #d7d7e2;
  }
  .pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 10px var(--lime);
  }
  .hero-h1 { max-width: 820px; margin-bottom: 22px; }
  .hero-lead { color: var(--text-dark-body); max-width: 640px; margin: 0; }

  /* ── Mission / story ──────────────────────────────────────────────── */
  .mission-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .mission-h2 { margin-top: 14px; }
  .mission-copy { display: flex; flex-direction: column; gap: 18px; }
  .mission-copy p {
    margin: 0;
    font-size: 16.5px;
    line-height: 1.7;
    color: var(--text-light-body);
  }
  @media (max-width: 900px) {
    .mission-grid { grid-template-columns: 1fr; gap: 28px; }
  }

  /* ── Principles ───────────────────────────────────────────────────── */
  .principles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
  }
  .principle {
    background: #fff;
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 26px;
  }
  .principle-n {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 30px;
    color: var(--violet);
    letter-spacing: -0.02em;
    margin-bottom: 14px;
  }
  .principle-t { font-size: 18px; margin: 0 0 8px; }
  .principle-d { font-size: 14px; line-height: 1.6; color: var(--text-light-body); margin: 0; }
  @media (max-width: 880px) {
    .principles { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .principles { grid-template-columns: 1fr; }
  }

  /* ── Final CTA ────────────────────────────────────────────────────── */
  .final {
    position: relative;
    overflow: hidden;
    background: linear-gradient(125deg, #0b0b12 0%, #241a52 50%, #3b82f6 135%);
  }
  .final-blob {
    position: absolute;
    top: -100px;
    left: 34%;
    width: 480px;
    height: 480px;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.5), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .final-wrap {
    padding-top: clamp(64px, 9vw, 112px);
    padding-bottom: clamp(64px, 9vw, 112px);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .final-h2 { color: #fff; margin-bottom: 26px; }
  .final-cta { justify-content: center; }
</style>
