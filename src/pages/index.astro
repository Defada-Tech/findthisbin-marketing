---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import DemoPanel from "../components/DemoPanel.astro";
import BinPlayground from "../components/BinPlayground.astro";
import CodeTabs from "../components/CodeTabs.astro";
import type { CodeTab } from "../components/CodeTabs.astro";
import {
  SITE_DESCRIPTION,
  BOOK_DEMO_LABEL,
  BOOK_DEMO_URL,
  SEE_DEPLOYMENT_LABEL,
  SEE_DEPLOYMENT_URL,
  TALK_TO_SALES_LABEL,
  TALK_TO_SALES_URL,
  PRICING_PATH,
  DOCS_PATH,
  API_REFERENCE_URL,
  ENGINE_BASE_URL,
  TRUST_POINTS,
} from "../lib/site";

const deployModels = [
  {
    name: "Self-hosted / BYOC",
    chip: "self-hosted",
    text: "Run it in your own cloud, VPC, or on-prem — air-gappable. Your infrastructure, your data, your control.",
    checks: ["Deploy via Helm / container", "Nothing leaves your network", "You operate the ops"],
    tone: "lime",
    highlight: false,
  },
  {
    name: "Managed in your cloud",
    chip: "most popular",
    text: "We deploy and operate the engine inside your environment. You keep the data; we keep it running.",
    checks: ["Runs in your VPC / account", "We handle upgrades & ops", "Data residency stays yours"],
    tone: "cyan",
    highlight: true,
  },
  {
    name: "Fully managed (BYOL)",
    chip: "fully managed",
    text: "We host and operate it; you onboard as an isolated tenant and bring your licenses. Zero infra, zero ops — your data stays isolated and yours.",
    checks: ["Isolated per-tenant data", "Bring your own licenses", "No infrastructure to manage"],
    tone: "lime",
    highlight: false,
  },
];

const connectors = [
  { badge: "VBASS", t: "Visa VBASS", d: "Official Visa BIN attribute source." },
  { badge: "MC", t: "Mastercard BIN table", d: "Mastercard range & product data." },
  { badge: "3P", t: "Commercial providers", d: "Third-party enrichment feeds." },
  { badge: "CSV", t: "CSV upload", d: "Your own corrections & overrides." },
  { badge: "SEED", t: "Bundled open seed data", d: "Works on day one, before you connect a thing.", seed: true },
];

const buildItems = [
  "Write & maintain 8-digit range logic",
  "Merge multiple sources and resolve conflicts with confidence",
  "Engineer a sub-10ms hot path that survives bursts",
  "Track freshness & dataset versioning",
  "Re-do it every time a network changes its files",
];
const deployItems = [
  "8-digit logic and multi-source merge, already built",
  "Per-field confidence and continuous corrections",
  "Sub-10ms p99 hot path out of the box",
  "Freshness, versioning, and ops handled",
  "Live in your cloud in days, not quarters",
];

const fields = [
  { k: "scheme", v: "Visa · MC · Amex" },
  { k: "type", v: "Credit / Debit" },
  { k: "category", v: "Consumer / Comm." },
  { k: "product / level", v: "World Elite" },
  { k: "issuer name", v: "Revolut Ltd" },
  { k: "issuer country", v: "GB" },
  { k: "issuer currency", v: "GBP" },
  { k: "prepaid flag", v: "true / false" },
  { k: "commercial flag", v: "true / false" },
  { k: "regulated debit", v: "true / false" },
  { k: "dcc_eligible", v: "true / false", hi: true },
  { k: "confidence", v: "0.98", hi: true },
  { k: "dataset_version", v: "2026-06-12" },
];

const useCases = [
  { t: "Least-cost & debit routing", d: "Route on real card type and regulated-debit status to cut acceptance cost." },
  { t: "Surcharging & interchange", d: "Charge and optimize correctly with consumer vs. commercial certainty." },
  { t: "DCC eligibility (EU)", d: "Offer compliant dynamic currency conversion with ECB-rate disclosure." },
  { t: "Checkout UX & card art", d: "Render the right scheme logo and card visuals the moment a BIN is typed." },
  { t: "Fraud & risk signals", d: "Flag issuer-country mismatches and prepaid cards in your risk engine." },
  { t: "Batch data enrichment", d: "Enrich historical transaction tables with accurate, versioned BIN data." },
];

const pspCards = [
  { t: "Smarter routing", d: "Least-cost & debit routing decisions from accurate type and regulated-debit flags.", tone: "violet" },
  { t: "Surcharging & interchange", d: "Apply correct surcharges and optimize interchange with commercial/consumer precision.", tone: "violet" },
  { t: "DCC eligibility for EU flows", d: "PSD2 / CBPR-ready disclosure with ECB reference-rate data points.", tone: "cyan" },
  { t: "Richer checkout UX & risk", d: "Card art and scheme logos, plus issuer-country signals for fraud screening.", tone: "cyan" },
];

const steps = [
  { n: "1", t: "Deploy in your cloud", d: "Install the engine in your VPC via Helm or container — or have us run it for you.", tone: "violet" },
  { n: "2", t: "Connect your licenses", d: "Plug in VBASS, Mastercard, commercial feeds, or CSV — or start on bundled seed data.", tone: "violet" },
  { n: "3", t: "Integrate the API", d: "Your engineers call a clean REST API with SDKs in 5 languages. Sub-10ms responses.", tone: "cyan" },
];

const howTabs: CodeTab[] = [
  { label: "cURL", lang: "bash", code: `curl ${ENGINE_BASE_URL}/v1/bins/53847012 \\\n  -H "Authorization: Bearer sk_live_..."` },
  { label: "Node", lang: "js", code: `import { FindThisBIN } from 'findthisbin'\nconst ftb = new FindThisBIN({ baseUrl: '${ENGINE_BASE_URL}', apiKey: 'sk_live_...' })\nconst card = await ftb.bins.get('53847012')` },
  { label: "Python", lang: "python", code: `from findthisbin import FindThisBIN\nftb = FindThisBIN(base_url='${ENGINE_BASE_URL}', api_key='sk_live_...')\ncard = ftb.bins.get('53847012')` },
  { label: "Go", lang: "go", code: `ftb := findthisbin.New("sk_live_...",\n  findthisbin.WithBaseURL("${ENGINE_BASE_URL}"))\ncard, err := ftb.Bins.Get("53847012")` },
  { label: "PHP", lang: "php", code: `$ftb = new FindThisBIN('sk_live_...', [\n  'base_url' => '${ENGINE_BASE_URL}',\n]);\n$card = $ftb->bins->get('53847012');` },
];

const tiers3 = [
  { name: "Startup", aud: "Single deployment", price: "Let’s talk", meta: "Core engine + base connectors, community support", cta: "Request pricing", dark: false, popular: false },
  { name: "Growth", aud: "HA & SLA", price: "Let’s talk", meta: "HA, more connectors, 99.9% SLA, standard support", cta: "Request pricing", dark: true, popular: true },
  { name: "Enterprise", aud: "Multi-environment & managed", price: "Custom", meta: "Fully-managed option, premium connectors, dedicated support", cta: "Talk to sales", dark: false, popular: false },
];

const compliance = [
  { t: "Your environment", d: "The engine runs in your cloud; your data never leaves it." },
  { t: "Out of the data path", d: "A processor model — we’re out of the card/data path entirely." },
  { t: "Out of PCI scope", d: "BIN-only — we never ingest full PANs." },
  { t: "DPA & EU option", d: "Per-customer DPA, EU-hosting option, SOC 2 in progress." },
];

const devCards = [
  { token: "{ }", t: "Docs", d: "Guides & quickstart", href: DOCS_PATH },
  { token: "GET", t: "API Reference", d: "Every endpoint", href: API_REFERENCE_URL },
  { token: "$ npm i", t: "SDKs", d: "5 languages", href: `${DOCS_PATH}#sdks` },
  { token: "▶", t: "Postman", d: "Import & run", href: `${DOCS_PATH}#sdks` },
];
---

<Layout
  title="FindThisBIN — The BIN intelligence engine you run in your own cloud"
  description={SITE_DESCRIPTION}
  active="home"
>
  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="hero-blob" aria-hidden="true"></div>
    <div class="wrap hero-wrap">
      <div class="hero-grid">
        <div class="hero-copy">
          <span class="hero-pill">
            <span class="dot" aria-hidden="true"></span>
            BIN intelligence engine · Runs in your cloud
          </span>
          <h1 class="h1 hero-h1">The BIN intelligence engine<br />payment platforms <span class="grad-text">run themselves.</span></h1>
          <p class="lead hero-lead">
            Deploy a fast, multi-source BIN engine in your own cloud — or let us run it for you.
            Plug in your own data licenses (Visa VBASS, Mastercard, commercial, CSV); we handle the
            8-digit logic, the merging, the sub-10ms performance, and the ops. Your data never leaves
            your environment.
          </p>
          <div class="cta-row hero-cta">
            <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" size="lg" />
            <Button href={SEE_DEPLOYMENT_URL} label={SEE_DEPLOYMENT_LABEL} variant="ghost-dark" size="lg" />
          </div>
          <div class="trust">
            {TRUST_POINTS.map((t) => <span class="trust-item"><span class="trust-dot" aria-hidden="true">●</span>{t}</span>)}
          </div>
        </div>
        <DemoPanel />
      </div>
    </div>
  </section>

  <!-- ============ VALUE PILLARS ============ -->
  <section id="product" class="band band-white">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="Why FindThisBIN" tone="violet" />
        <h2 class="h2">Engineered for the teams that move money.</h2>
      </div>
      <div class="pillars" data-reveal>
        <article class="pillar dark">
          <div class="pillar-glow glow-violet" aria-hidden="true"></div>
          <div class="pillar-body">
            <div class="pillar-eyebrow lime">01 · DEPLOY IN YOUR CLOUD</div>
            <h3 class="h3">Run it where your data lives.</h3>
            <p class="pillar-text">Self-host in your own cloud, VPC, or on-prem — air-gappable. Or let us deploy and operate it inside your environment. Same engine either way; you choose who runs the ops.</p>
            <pre class="mini-code mono"><code>$ helm install findthisbin ./engine
<span class="cm">// → running in your-cloud · eu-west-1</span></code></pre>
          </div>
        </article>

        <article class="pillar light">
          <div class="pillar-eyebrow violet">02 · COMPLIANCE &amp; DATA RESIDENCY</div>
          <h3 class="h3 ink">Your data never leaves.</h3>
          <p class="pillar-text light">The engine runs in your environment, so your data stays in your VPC. We’re out of PCI scope and out of the card/data path entirely — a processor model with a per-customer DPA, an EU-hosting option, and SOC 2 in progress.</p>
          <div class="chips">
            {["Out of PCI scope", "Data stays in your VPC", "Per-customer DPA", "EU-hosting option"].map((c) => <span class="chip">{c}</span>)}
          </div>
        </article>

        <article class="pillar light">
          <div class="pillar-eyebrow violet">03 · BUILD VS. BUY</div>
          <h3 class="h3 ink">Live this week, not in two quarters.</h3>
          <p class="pillar-text light">The 8-digit range logic, multi-source merge with confidence, the sub-10ms hot path, freshness and versioning, and the ongoing ops as networks change their files — it’s all built. Deploy the engine instead of staffing a team to maintain it.</p>
          <div class="accuracy-stat">
            <div class="big-8">days</div>
            <div class="big-8-sub">to production —<br />not months of specialist work</div>
          </div>
        </article>

        <article class="pillar dark">
          <div class="pillar-glow glow-cyan glow-bl" aria-hidden="true"></div>
          <div class="pillar-body">
            <div class="pillar-eyebrow cyan">04 · CORRECTNESS &amp; PERFORMANCE</div>
            <h3 class="h3">Correct data, on the hot path.</h3>
            <p class="pillar-text">True 8-digit precision and multi-source merge with per-field confidence, served at sub-10ms p99 and resistant to BIN-enumeration bursts. Your engineers integrate a clean REST API with SDKs in 5 languages.</p>
            <div class="perf-mini">
              <div><div class="perf-n">&lt;10ms</div><div class="perf-l">p99 latency</div></div>
              <div><div class="perf-n">8-digit</div><div class="perf-l">range precision</div></div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ DEPLOYMENT MODELS ============ -->
  <section id="deployment" class="band band-ink deploy">
    <div class="deploy-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <Eyebrow label="Deployment models" tone="lime" class="center-eyebrow" />
        <h2 class="h2 on-dark">One engine. You choose who runs it.</h2>
        <p class="lead lead-center on-dark">Self-host it, have us operate it in your cloud, or run fully managed. Every model runs the exact same engine — the only difference is who keeps the lights on.</p>
      </div>
      <div class="deploy-cards" data-reveal>
        {
          deployModels.map((m) => (
            <article class:list={["deploy-card", m.highlight && "highlight"]}>
              <span class="deploy-chip">{m.chip}</span>
              <h3 class="h3">{m.name}</h3>
              <p class="deploy-text">{m.text}</p>
              <ul class="deploy-checks">
                {m.checks.map((c) => (
                  <li><span class:list={["check", m.tone]} aria-hidden="true">✓</span>{c}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="cta-row center deploy-cta" data-reveal>
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" />
      </div>
    </div>
  </section>

  <!-- ============ BRING YOUR OWN LICENSES / CONNECTORS ============ -->
  <section class="band band-white byol">
    <div class="wrap">
      <div class="two-col two-col-start">
        <div data-reveal>
          <Eyebrow label="Bring your own licenses" tone="violet" />
          <h2 class="h2 byol-h2">Plug in your licenses. We did the hard logic.</h2>
          <p class="lead">Connect the data you already license and the engine handles the 8-digit ranges, the multi-source merge, the confidence scoring, and the freshness. It works on day one with bundled open seed data while you onboard your sources.</p>
          <p class="byol-note">Don’t have a license yet? We’ll help you connect to the right providers.</p>
          <div class="cta-row">
            <Button href={TALK_TO_SALES_URL} label="Talk to sales about connectors" variant="primary" />
          </div>
        </div>
        <div class="connector-list" data-reveal>
          {
            connectors.map((c) => (
              <div class:list={["connector", c.seed && "seed"]}>
                <span class="connector-badge mono">{c.badge}</span>
                <div>
                  <div class="connector-t">{c.t}</div>
                  <div class="connector-d">{c.d}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ TRY IT LIVE ============ -->
  <section id="try" class="band band-ink try">
    <div class="try-bg" aria-hidden="true"></div>
    <div class="wrap wrap-narrow">
      <div class="section-head center" data-reveal>
        <Eyebrow label="Playground" tone="cyan" class="center-eyebrow" />
        <h2 class="h2 on-dark">Look up any BIN, right now.</h2>
        <p class="lead lead-center">Type a 6–8 digit BIN and see the engine’s output — the same record your integration receives, wherever you run it.</p>
      </div>
      <div data-reveal>
        <BinPlayground />
      </div>
      <div class="cta-row center try-cta" data-reveal>
        <Button href={BOOK_DEMO_URL} label="See it on your own BINs — book a demo" variant="primary" />
      </div>
    </div>
  </section>

  <!-- ============ WHAT YOU GET ============ -->
  <section class="band band-off">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="One call, everything" tone="violet" />
        <h2 class="h2">Every field your stack needs.</h2>
        <p class="lead">A single BIN lookup returns the full card-intelligence record — typed, scored, and versioned.</p>
      </div>
      <div class="fields" data-reveal>
        {
          fields.map((f) => (
            <div class="field-chip">
              <div class="field-k mono">{f.k}</div>
              <div class:list={["field-v", f.hi && "hi"]}>{f.v}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ BUILD VS. BUY ============ -->
  <section class="band band-white bvb-band">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="Build vs. buy" tone="violet" />
        <h2 class="h2">Months of specialist work, or a deployment this week.</h2>
        <p class="lead">BIN intelligence looks simple until you own it. Here’s what you’d carry in-house versus what you get on day one.</p>
      </div>
      <div class="bvb" data-reveal>
        <div class="bvb-col build">
          <div class="bvb-head">Build it in-house</div>
          <ul>
            {buildItems.map((i) => <li><span class="x" aria-hidden="true">✕</span>{i}</li>)}
          </ul>
        </div>
        <div class="bvb-col deploy">
          <div class="bvb-head">Deploy the engine</div>
          <ul>
            {deployItems.map((i) => <li><span class="c" aria-hidden="true">✓</span>{i}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PSP SECTION ============ -->
  <section id="psp" class="band band-ink psp">
    <div class="psp-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="two-col">
        <div data-reveal>
          <Eyebrow label="For payment platforms" tone="cyan" />
          <h2 class="h2 on-dark psp-h2">Embed card intelligence across your entire stack.</h2>
          <p class="lead on-dark">PSPs, orchestrators, and ISVs run the FindThisBIN engine to power smarter routing, surcharging, DCC eligibility, richer checkout UX, and risk signals — all from one deployment. White-label, high-volume pricing, SLAs, and EU data-residency guarantees included.</p>
          <div class="cta-row">
            <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="primary" />
            <Button href={PRICING_PATH} label="See platform pricing" variant="ghost-dark" />
          </div>
        </div>
        <div class="psp-cards" data-reveal>
          {
            pspCards.map((c) => (
              <div class="psp-card">
                <span class:list={["psp-arrow", c.tone]}>↳</span>
                <div>
                  <div class="psp-card-t">{c.t}</div>
                  <div class="psp-card-d">{c.d}</div>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ USE CASES ============ -->
  <section class="band band-white">
    <div class="wrap">
      <h2 class="h2 usecases-h2" data-reveal>One dataset, six revenue levers.</h2>
      <div class="usecases" data-reveal>
        {
          useCases.map((u) => (
            <div class="usecase">
              <div class="usecase-t">{u.t}</div>
              <div class="usecase-d">{u.d}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ HOW IT WORKS ============ -->
  <section class="band band-ink">
    <div class="wrap">
      <div class="two-col two-col-start">
        <div data-reveal>
          <Eyebrow label="How it works" tone="lime" />
          <h2 class="h2 on-dark how-h2">Three steps to production.</h2>
          <div class="steps">
            {
              steps.map((s) => (
                <div class="step">
                  <span class:list={["step-num", s.tone]}>{s.n}</span>
                  <div>
                    <div class="step-t">{s.t}</div>
                    <div class="step-d">{s.d}</div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>
        <div data-reveal>
          <CodeTabs id="how-it-works" tabs={howTabs} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ PRICING PREVIEW ============ -->
  <section class="band band-off">
    <div class="wrap">
      <div class="section-head center" data-reveal>
        <h2 class="h2">Pricing that fits your deployment.</h2>
        <p class="lead lead-center">From a single deployment to multi-environment and fully-managed. We scope a plan around your volume, connectors, and SLAs.</p>
      </div>
      <div class="price3" data-reveal>
        {
          tiers3.map((p) => (
            <div class:list={["price-card", p.dark && "dark"]}>
              {p.popular && <span class="popular-badge">MOST POPULAR</span>}
              <div class="price-name">{p.name}</div>
              <div class="price-aud">{p.aud}</div>
              <div class="price-amt txt">{p.price}</div>
              <div class="price-meta">{p.meta}</div>
              <a href={TALK_TO_SALES_URL} class:list={["price-cta", p.popular ? "lime" : p.dark ? "dark" : "soft"]}>{p.cta}</a>
            </div>
          ))
        }
      </div>
      <div class="price-compare">
        <a href={PRICING_PATH}>Compare all plans &amp; features →</a>
      </div>
    </div>
  </section>

  <!-- ============ COMPLIANCE & RESIDENCY CALLOUT ============ -->
  <section class="band band-white compliance-band">
    <div class="wrap">
      <div class="compliance" data-reveal>
        {
          compliance.map((c) => (
            <div class="compliance-item">
              <span class="compliance-t">{c.t}</span>
              <span class="compliance-d">{c.d}</span>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DEV / DOCS CTA ============ -->
  <section class="band band-ink dev">
    <div class="dev-grid-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="two-col">
        <div data-reveal>
          <Eyebrow label="For developers" tone="cyan" />
          <h2 class="h2 on-dark dev-h2">Everything you need to integrate in minutes.</h2>
          <p class="lead on-dark">Beautiful docs, a full API reference, SDKs in 5 languages, and a Postman collection. Built for the way payment engineers actually work.</p>
          <div class="cta-row">
            <Button href={DOCS_PATH} label="Read the docs" variant="primary" />
            <Button href={API_REFERENCE_URL} label="API reference" variant="ghost-dark" />
          </div>
        </div>
        <div class="dev-cards" data-reveal>
          {
            devCards.map((d) => (
              <a href={d.href} class="dev-card">
                <div class="dev-token mono">{d.token}</div>
                <div class="dev-card-t">{d.t}</div>
                <div class="dev-card-d">{d.d}</div>
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="final-blob" aria-hidden="true"></div>
    <div class="wrap wrap-tight final-wrap">
      <h2 class="h1-page final-h2" data-reveal>Run BIN intelligence in your own cloud.</h2>
      <p class="final-lead" data-reveal>Book a walkthrough and we’ll scope a proof-of-concept deployed in your environment — live in days, not quarters.</p>
      <div class="cta-row center final-cta" data-reveal>
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" size="lg" />
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="ghost-dark" size="lg" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero ─────────────────────────────────────────────────────────── */
  .hero {
    position: relative;
    background: var(--ink);
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(120% 90% at 70% -10%, rgba(124, 92, 255, 0.3), rgba(11, 11, 18, 0) 55%),
      radial-gradient(80% 70% at 8% 8%, rgba(34, 211, 238, 0.16), rgba(11, 11, 18, 0) 50%);
  }
  .hero-blob {
    position: absolute;
    top: -120px;
    right: -80px;
