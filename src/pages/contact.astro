---
export const prerender = false; // SSR so success/error render without JS (reads query params)

import Layout from "../layouts/Layout.astro";
import ContactForm from "../components/ContactForm.astro";
import { BOOK_DEMO_LABEL, TALK_TO_SALES_LABEL } from "../lib/site";

const params = Astro.url.searchParams;
// Any other intent value (incl. legacy ones like `careers`) falls through to demo.
const intent = params.get("intent") === "sales" ? "sales" : "demo";
const submitted = params.get("sent") === "1";
const error =
  params.get("error") === "1"
    ? "Please provide your name, a valid work email, and your company."
    : undefined;

const copy =
  intent === "sales"
    ? {
        eyebrow: TALK_TO_SALES_LABEL,
        heading: "Let’s talk deployment.",
        subhead:
          "Tell us about your platform and we’ll scope the right deployment model, connectors, SLA, and data-residency setup for you.",
        nextStep:
          "A solutions engineer reviews your note and replies within one business day to scope deployment and pricing.",
        emailLabel: "sales@findthisbin.com",
        emailHref: "mailto:sales@findthisbin.com",
      }
    : {
        eyebrow: BOOK_DEMO_LABEL,
        heading: "See the engine in your stack.",
        subhead:
          "Book a walkthrough with a solutions engineer. We’ll show the engine running in a cloud like yours, with licensed sources plugged in — and scope a proof-of-concept.",
        nextStep:
          "A solutions engineer reaches out within one business day to schedule your walkthrough and a proof-of-concept deployed in your cloud.",
        emailLabel: "demo@findthisbin.com",
        emailHref: "mailto:demo@findthisbin.com",
      };

const points = [
  "Deployed in your cloud in days, not months",
  "Your data never leaves your environment",
  "Out of PCI scope · DPA · EU-hosting option",
];

const title = `${copy.heading.replace(/’/g, "'").replace(/\.$/, "")} — FindThisBIN`;
const description =
  intent === "sales"
    ? "Talk to the FindThisBIN team about deploying the BIN intelligence engine in your cloud — deployment models, connectors, SLAs, and EU data residency."
    : "Book a FindThisBIN demo: see the BIN intelligence engine running in a cloud like yours, with your licensed sources plugged in, and scope a proof-of-concept.";
---

<Layout title={title} description={description}>
  <section class="band band-ink contact">
    <div class="bg" aria-hidden="true"></div>
    <div class="wrap contact-grid">
      <!-- LEFT: reassurance -->
      <div class="reassure-col" data-reveal>
        <div class="pill">
          <span class="dot" aria-hidden="true"></span>
          <span>{copy.eyebrow}</span>
        </div>
        <h1 class="h1-page">{copy.heading}</h1>
        <p class="lead">{copy.subhead}</p>

        <ul class="points">
          {points.map((p) => (
            <li><span class="tick" aria-hidden="true">✓</span><span>{p}</span></li>
          ))}
        </ul>

        <div class="next-card">
          <div class="next-label">What happens next</div>
          <p>{copy.nextStep}</p>
          <div class="next-email">
            Prefer email? <a href={copy.emailHref}>{copy.emailLabel}</a>
          </div>
        </div>
      </div>

      <!-- RIGHT: form / success -->
      <div class="form-col" data-reveal>
        <ContactForm intent={intent} submitted={submitted} error={error} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .contact { display: flex; align-items: flex-start; }
  .bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(100% 80% at 78% -10%, color-mix(in srgb, var(--violet) 28%, transparent), transparent 55%),
      radial-gradient(70% 60% at 5% 10%, color-mix(in srgb, var(--cyan) 14%, transparent), transparent 55%);
  }
  .contact-grid {
    display: grid;
    grid-template-columns: 0.85fr 1fr;
    gap: 48px;
    align-items: start;
    width: 100%;
  }
  @media (max-width: 940px) {
    .contact-grid { grid-template-columns: 1fr; gap: 36px; }
  }

  /* .pill itself is global (global.css); only its rhythm here is local. */
  .reassure-col .pill { margin-bottom: 22px; }

  .h1-page { margin: 0 0 18px; max-width: 14ch; }
  .reassure-col .lead { color: var(--text-dark-body); margin: 0 0 32px; max-width: 440px; }

  .points {
    list-style: none;
    margin: 0 0 34px;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .points li {
    display: flex;
    gap: 13px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.5;
    color: var(--text-dark-soft);
  }
  .tick { flex: none; margin-top: 1px; color: var(--lime); }

  .next-card {
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 14px;
    padding: 20px;
  }
  .next-label {
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-light-muted);
    margin-bottom: 8px;
  }
  .next-card p {
    margin: 0;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark-muted);
  }
  .next-email {
    margin-top: 14px;
    font-size: 14px;
    color: var(--text-dark-muted-2);
  }
  .next-email a { color: var(--cyan); text-decoration: none; font-weight: 500; }
  .next-email a:hover { text-decoration: underline; }
</style>
