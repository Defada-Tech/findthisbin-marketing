---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import CodeTabs from "../components/CodeTabs.astro";
import type { CodeTab } from "../components/CodeTabs.astro";
import {
  GET_API_KEY_LABEL,
  GET_API_KEY_URL,
  API_REFERENCE_URL,
  OPENAPI_SPEC_URL,
  POSTMAN_URL,
  STATUS_URL,
  GITHUB_URL,
} from "../lib/site";

const quickTabs: CodeTab[] = [
  { label: "cURL", lang: "bash", code: `curl https://api.findthisbin.com/v1/bins/53847012 \\\n  -H "Authorization: Bearer sk_live_..."` },
  { label: "Node", lang: "js", code: `import { FindThisBIN } from 'findthisbin'\nconst ftb = new FindThisBIN('sk_live_...')\nconst card = await ftb.bins.get('53847012')` },
  { label: "Python", lang: "python", code: `from findthisbin import FindThisBIN\nftb = FindThisBIN('sk_live_...')\ncard = ftb.bins.get('53847012')` },
];

const quickSteps = [
  { n: "1", t: "Get an API key", d: "Sign up free — test & live keys, no card.", tone: "violet" },
  { n: "2", t: "Make your first request", d: "One GET call with the BIN.", tone: "violet" },
  { n: "3", t: "Read the response", d: "Rich, typed, scored card data.", tone: "cyan" },
];

const docCards = [
  { icon: "▸", t: "Quickstart", d: "Your first lookup in 5 minutes.", href: "#" },
  { icon: "key", t: "Authentication", d: "API keys, test vs live.", href: "#" },
  { icon: "GET", t: "BIN Lookup API", d: "The core single-BIN endpoint.", href: "#reference" },
  { icon: "[ ]", t: "Batch Lookup", d: "Enrich up to 10k BINs per call.", href: "#" },
  { icon: "€$", t: "DCC endpoint", d: "ECB reference-rate disclosure.", href: "#" },
  { icon: "⇄", t: "Webhooks", d: "Dataset-update notifications.", href: "#" },
  { icon: "4xx", t: "Errors & rate limits", d: "Status codes and quotas.", href: "#" },
  { icon: "{ }", t: "Data dictionary", d: "Every field explained.", href: "#" },
  { icon: "v1", t: "Versioning", d: "API & dataset versions.", href: "#" },
];

const sdks = [
  { name: "Node", cmd: "npm i findthisbin" },
  { name: "Python", cmd: "pip install findthisbin" },
  { name: "Go", cmd: "go get findthisbin.com/go" },
  { name: "PHP", cmd: "composer require findthisbin/sdk" },
  { name: "Java", cmd: "implementation 'com.findthisbin:sdk'" },
];

const guides = [
  "Detecting prepaid & commercial cards",
  "DCC compliance in the EU (ECB rates)",
  "The 8-digit BIN migration",
  "Working with match confidence",
];
---

<Layout
  title="Docs — FindThisBIN"
  description="Build with FindThisBIN. From your first BIN lookup to production in minutes — quickstart, API reference, SDKs in five languages, and guides."
  active="docs"
>
  <!-- ============ HEADER ============ -->
  <section class="band-off doc-header">
    <div class="wrap wrap-narrow">
      <p class="eyebrow-mono mono">// docs</p>
      <h1 class="h1-page ink-h1">Build with FindThisBIN.</h1>
      <p class="doc-sub">From your first BIN lookup to production in minutes.</p>
      <div class="search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8A8A9A" stroke-width="2" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle><path d="M21 21l-4.3-4.3"></path>
        </svg>
        <input type="search" placeholder="Search the docs…" aria-label="Search the docs" />
        <span class="kbd mono">⌘K</span>
      </div>
    </div>
  </section>

  <!-- ============ QUICKSTART ============ -->
  <section class="band-white doc-section">
    <div class="wrap wrap-docs">
      <div class="quick-grid">
        <div class="quick-card" data-reveal>
          <div class="quick-glow" aria-hidden="true"></div>
          <div class="quick-inner">
            <span class="quick-pill">
              <span class="dot" aria-hidden="true"></span>
              5-minute quickstart
            </span>
            <h2 class="quick-h2">First lookup in three steps.</h2>
            <div class="quick-steps">
              {
                quickSteps.map((s) => (
                  <div class="qstep">
                    <span class:list={["qstep-num", s.tone]}>{s.n}</span>
                    <div>
                      <div class="qstep-t">{s.t}</div>
                      <div class="qstep-d">{s.d}</div>
                    </div>
                  </div>
                ))
              }
            </div>
            <a href={GET_API_KEY_URL} class="quick-cta">Start here</a>
          </div>
        </div>
        <div class="quick-code" data-reveal>
          <CodeTabs
            id="quickstart"
            tabs={quickTabs}
            footer={'→ 200 OK · scheme: "mastercard" · confidence: 0.98'}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ DOC GRID ============ -->
  <section class="band-off doc-section">
    <div class="wrap wrap-docs">
      <h2 class="doc-h2" data-reveal>Documentation</h2>
      <div class="doc-grid" data-reveal>
        {
          docCards.map((c) => (
            <a href={c.href} class="doc-card">
              <div class="doc-icon mono">{c.icon}</div>
              <div class="doc-card-t">{c.t}</div>
              <div class="doc-card-d">{c.d}</div>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ SDKS ============ -->
  <section id="sdks" class="band-white doc-section">
    <div class="wrap wrap-docs">
      <div class="sdk-head" data-reveal>
        <h2 class="doc-h2 m0">SDKs &amp; tools</h2>
        <div class="sdk-links">
          <a href={OPENAPI_SPEC_URL} target="_blank" rel="noopener">OpenAPI spec ↓</a>
          <a href={POSTMAN_URL} target="_blank" rel="noopener">Postman collection →</a>
        </div>
      </div>
      <div class="sdk-grid" data-reveal>
        {
          sdks.map((s) => (
            <div class="sdk-card">
              <div class="sdk-name">{s.name}</div>
              <div class="sdk-cmd mono">{s.cmd}</div>
            </div>
          ))
        }
        <div class="sdk-card sdk-gradient">
          <div class="sdk-name">All SDKs are open source</div>
          <a href={GITHUB_URL} target="_blank" rel="noopener" class="sdk-gh">View on GitHub →</a>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ API REFERENCE ============ -->
  <section id="reference" class="band-ink doc-section">
    <div class="wrap wrap-docs">
      <div class="ref-grid">
        <div data-reveal>
          <Eyebrow label="API reference" tone="cyan" />
          <h2 class="h2 on-dark ref-h2">Full API reference.</h2>
          <p class="lead on-dark ref-lead">Every endpoint, parameter, and field — with copy-ready examples in five languages.</p>
          <a href={API_REFERENCE_URL} class="ref-cta">Open reference</a>
        </div>
        <div class="ref-panel" data-reveal>
          <div class="ref-panel-head mono">
            <span class="ref-verb">GET</span>
            <span class="ref-path">/v1/bins/<span class="ref-bin">{"{bin}"}</span></span>
          </div>
          <pre class="ref-body mono"><code><span class="cm"># request</span>
<span class="pn">-H</span> <span class="s">"Authorization: Bearer sk_live_..."</span>

<span class="cm"># response</span>
<span class="pn">{"{"}</span>
  <span class="k">"bin"</span><span class="pn">: </span><span class="s">"53847012"</span><span class="pn">,</span>
  <span class="k">"scheme"</span><span class="pn">: </span><span class="s">"mastercard"</span><span class="pn">,</span>
  <span class="k">"type"</span><span class="pn">: </span><span class="s">"credit"</span><span class="pn">,</span>
  <span class="k">"issuer"</span><span class="pn">: {"{"} </span><span class="k">"name"</span><span class="pn">: </span><span class="s">"Revolut Ltd"</span><span class="pn">, </span><span class="k">"country"</span><span class="pn">: </span><span class="s">"GB"</span><span class="pn"> {"}"},</span>
  <span class="k">"dcc_eligible"</span><span class="pn">: </span><span class="n">true</span><span class="pn">,</span>
  <span class="k">"confidence"</span><span class="pn">: </span><span class="n">0.98</span>
<span class="pn">{"}"}</span></code></pre>
        </div>
      </div>
    </div>
  </section>

  <!-- ============ GUIDES ============ -->
  <section class="band-off doc-section">
    <div class="wrap wrap-docs">
      <h2 class="doc-h2" data-reveal>Guides</h2>
      <div class="guides" data-reveal>
        {
          guides.map((g) => (
            <a href="#" class="guide">
              <span>{g}</span>
              <span class="guide-arrow" aria-hidden="true">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ UTILITY BAR ============ -->
  <section class="band-white util-bar">
    <div class="wrap wrap-docs util-inner">
      <div class="util-links">
        <a href={STATUS_URL} target="_blank" rel="noopener" class="util-status">
          <span class="status-dot" aria-hidden="true"></span>Status
        </a>
        <a href="#">Changelog</a>
        <a href="#">Support</a>
      </div>
      <a href={GET_API_KEY_URL} class="util-cta">{GET_API_KEY_LABEL}</a>
    </div>
  </section>
</Layout>

<style>
  .doc-section { padding: clamp(48px, 6vw, 80px) 0; }

  /* ── Header ───────────────────────────────────────────────────────── */
  .doc-header {
    border-bottom: 1px solid var(--border-light);
    padding: clamp(48px, 7vw, 80px) 0;
  }
  .eyebrow-mono { font-size: 13px; color: var(--violet); font-weight: 600; margin: 0 0 14px; }
  .ink-h1 { color: var(--ink); }
  .doc-sub { font-size: clamp(16px, 1.8vw, 19px); line-height: 1.6; color: var(--text-light-body); margin: 14px 0 28px; max-width: 560px; }
  .search {
    display: flex;
    align-items: center;
    gap: 12px;
    background: #fff;
    border: 1px solid #e0e0ea;
    border-radius: 13px;
    padding: 0 16px;
    max-width: 520px;
    box-shadow: 0 4px 16px -8px rgba(0, 0, 0, 0.1);
  }
  .search input {
    flex: 1;
    border: 0;
    outline: none;
    background: transparent;
    font-size: 16px;
    padding: 15px 0;
    color: var(--ink);
    font-family: var(--font-sans);
    min-width: 0;
  }
  .kbd { font-size: 12px; color: #a0a0ae; border: 1px solid var(--border-light); border-radius: 6px; padding: 3px 7px; }

  /* ── Shared light heading ─────────────────────────────────────────── */
  .doc-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(24px, 3vw, 34px); letter-spacing: -0.02em; margin: 0 0 28px; color: var(--ink); }
  .m0 { margin: 0; }

  /* ── Quickstart ───────────────────────────────────────────────────── */
  .quick-grid { display: grid; grid-template-columns: 1fr 1.1fr; gap: 32px; align-items: stretch; }
  .quick-card {
    position: relative;
    overflow: hidden;
    background: linear-gradient(160deg, #0b0b12, #1a1340);
    border-radius: 20px;
    padding: clamp(28px, 3.5vw, 40px);
    color: #fff;
  }
  .quick-glow {
    position: absolute;
    top: -50px;
    right: -50px;
    width: 200px;
    height: 200px;
    background: radial-gradient(circle, rgba(124, 92, 255, 0.45), transparent 70%);
    filter: blur(14px);
  }
  .quick-inner { position: relative; z-index: 1; }
  .quick-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 12px;
    border-radius: 999px;
    background: rgba(196, 245, 66, 0.14);
    border: 1px solid rgba(196, 245, 66, 0.3);
    margin-bottom: 20px;
    font-size: 12.5px;
    font-weight: 600;
    color: var(--lime);
  }
  .quick-pill .dot { width: 6px; height: 6px; border-radius: 50%; background: var(--lime); }
  .quick-h2 { font-family: var(--font-display); font-weight: 700; font-size: clamp(26px, 3.2vw, 34px); letter-spacing: -0.02em; margin: 0 0 24px; }
  .quick-steps { display: flex; flex-direction: column; gap: 18px; margin-bottom: 28px; }
  .qstep { display: flex; gap: 14px; align-items: flex-start; }
  .qstep-num {
    flex: none;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 14px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .qstep-num.violet { background: rgba(124, 92, 255, 0.2); border: 1px solid rgba(124, 92, 255, 0.4); color: var(--violet-light); }
  .qstep-num.cyan { background: rgba(34, 211, 238, 0.2); border: 1px solid rgba(34, 211, 238, 0.4); color: var(--cyan); }
  .qstep-t { font-weight: 600; font-size: 15.5px; }
  .qstep-d { font-size: 13.5px; color: var(--text-dark-muted); }
  .quick-cta {
    display: inline-block;
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    background: var(--lime);
    padding: 13px 24px;
    border-radius: 11px;
  }
  .quick-code { display: flex; }
  .quick-code :global(.code-tabs) { width: 100%; border-color: var(--border-light); }
  @media (max-width: 900px) {
    .quick-grid { grid-template-columns: 1fr; }
  }

  /* ── Doc grid ─────────────────────────────────────────────────────── */
  .doc-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .doc-card {
    text-decoration: none;
    background: #fff;
    border: 1px solid var(--border-light);
    border-radius: 14px;
    padding: 22px;
    display: block;
    transition: border-color 0.15s ease, transform 0.15s ease;
  }
  .doc-card:hover { border-color: var(--violet); transform: translateY(-2px); }
  .doc-icon { color: var(--violet); font-size: 15px; margin-bottom: 12px; }
  .doc-card-t { font-family: var(--font-display); font-weight: 700; font-size: 16.5px; color: var(--ink); margin-bottom: 5px; }
  .doc-card-d { font-size: 13.5px; color: var(--text-light-muted); line-height: 1.5; }
  @media (max-width: 900px) { .doc-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .doc-grid { grid-template-columns: 1fr; } }

  /* ── SDKs ─────────────────────────────────────────────────────────── */
  .sdk-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px; margin-bottom: 28px; }
  .sdk-links { display: flex; gap: 18px; }
  .sdk-links a { font-size: 14.5px; font-weight: 600; color: var(--violet); text-decoration: none; }
  .sdk-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .sdk-card { background: var(--ink-2); border-radius: 14px; padding: 22px; }
  .sdk-name { font-family: var(--font-display); font-weight: 700; font-size: 16px; color: #fff; margin-bottom: 12px; }
  .sdk-cmd { background: #0a0a12; border-radius: 9px; padding: 12px 14px; font-size: 12.5px; color: #9ee493; overflow-x: auto; white-space: nowrap; }
  .sdk-gradient { background: linear-gradient(150deg, #7c5cff, #3b82f6); display: flex; flex-direction: column; justify-content: center; }
  .sdk-gradient .sdk-name { margin-bottom: 5px; }
  .sdk-gh { font-size: 13.5px; color: #fff; text-decoration: underline; }
  @media (max-width: 860px) { .sdk-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .sdk-grid { grid-template-columns: 1fr; } }

  /* ── API reference ────────────────────────────────────────────────── */
  .ref-grid { display: grid; grid-template-columns: 1fr 1.3fr; gap: 32px; align-items: center; }
  .ref-h2 { margin: 14px 0 16px; font-size: clamp(28px, 3.6vw, 42px); }
  .ref-lead { margin-bottom: 24px; max-width: 420px; }
  .ref-cta {
    display: inline-block;
    text-decoration: none;
    font-weight: 600;
    font-size: 15.5px;
    color: var(--ink);
    background: var(--lime);
    padding: 13px 24px;
    border-radius: 11px;
  }
  .ref-panel { background: var(--ink-2); border: 1px solid var(--border-dark); border-radius: 16px; overflow: hidden; }
  .ref-panel-head {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 14px 18px;
    background: var(--ink-soft);
    border-bottom: 1px solid var(--border-dark);
  }
  .ref-verb { background: var(--cyan); color: var(--ink); font-weight: 700; padding: 2px 9px; border-radius: 6px; font-size: 11px; }
  .ref-path { font-size: 13px; color: #e6e6f0; }
  .ref-bin { color: #c4a5ff; }
  .ref-body { margin: 0; padding: 18px; font-size: 12.5px; line-height: 1.7; color: #717184; overflow-x: auto; white-space: pre; }
  .ref-body .cm { color: #5c5c6e; }
  .ref-body .k { color: #7dd3fc; }
  .ref-body .s { color: #9ee493; }
  .ref-body .n { color: #c4a5ff; }
  .ref-body .pn { color: #717184; }
  @media (max-width: 900px) { .ref-grid { grid-template-columns: 1fr; } }

  /* ── Guides ───────────────────────────────────────────────────────── */
  .guides { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; }
  .guide {
    text-decoration: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    background: #fff;
    border: 1px solid var(--border-light);
    border-radius: 13px;
    padding: 20px 22px;
    font-weight: 600;
    font-size: 15.5px;
    color: var(--ink);
    transition: border-color 0.15s ease;
  }
  .guide:hover { border-color: var(--violet); }
  .guide-arrow { color: var(--violet); }

  /* ── Utility bar ──────────────────────────────────────────────────── */
  .util-bar { border-top: 1px solid var(--border-light); padding: clamp(40px, 5vw, 64px) 0; }
  .util-inner { display: flex; flex-wrap: wrap; gap: 24px; align-items: center; justify-content: space-between; }
  .util-links { display: flex; flex-wrap: wrap; gap: 24px; }
  .util-links a { text-decoration: none; font-size: 15px; font-weight: 600; color: var(--ink); display: inline-flex; align-items: center; gap: 8px; }
  .status-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--status-green); }
  .util-cta {
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--ink);
    background: var(--lime);
    padding: 13px 24px;
    border-radius: 11px;
    box-shadow: 0 10px 30px -10px rgba(196, 245, 66, 0.5);
  }
</style>
