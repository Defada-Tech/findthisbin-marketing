---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import CodeTabs from "../components/CodeTabs.astro";
import type { CodeTab } from "../components/CodeTabs.astro";
import {
  SITE_NAME,
  PRODUCT_PATH,
  BOOK_DEMO_LABEL,
  BOOK_DEMO_URL,
  TALK_TO_SALES_LABEL,
  TALK_TO_SALES_URL,
  ENGINE_BASE_URL,
} from "../lib/site";

const PRODUCT_DESCRIPTION =
  "Deploy the BIN intelligence engine in your own cloud, plug in your data licenses, and turn any 6–8 digit BIN into a complete, typed, scored card record — scheme, type, issuer, country, currency, DCC eligibility, and confidence. EU-hosted option, out of PCI scope, sub-10ms p99.";

const lookupFields = [
  { k: "Identity", d: "scheme, type, category, product / card level." },
  { k: "Issuer", d: "name, country, and settlement currency." },
  { k: "Flags & DCC", d: "prepaid, commercial, regulated-debit, DCC eligibility." },
  { k: "Provenance", d: "per-field confidence and dataset version." },
];

const responseTab: CodeTab[] = [
  {
    label: "Response",
    lang: "json",
    code: `{
  "bin": "53847012",
  "scheme": "mastercard",
  "type": "credit",
  "category": "consumer",
  "product": "World Elite Mastercard",
  "issuer": { "name": "Revolut Ltd", "country": "GB", "currency": "GBP" },
  "flags": { "prepaid": false, "commercial": false },
  "dcc_eligible": true,
  "confidence": 0.98,
  "dataset_version": "2026-06-12"
}`,
  },
];

const endpoints = [
  {
    verb: "GET",
    tone: "cyan",
    path: "/v1/bins/{bin}",
    t: "Single lookup",
    d: "The core endpoint — one BIN, the full card-intelligence record in milliseconds.",
  },
  {
    verb: "POST",
    tone: "lime",
    path: "/v1/bins/batch",
    t: "Batch lookup",
    d: "Enrich up to 10,000 BINs per call — perfect for backfilling transaction tables.",
  },
  {
    verb: "GET",
    tone: "cyan",
    path: "/v1/dcc/{bin}",
    t: "DCC disclosure",
    d: "DCC eligibility with ECB reference-rate data points for PSD2 / CBPR compliance.",
  },
];

const useCases = [
  { t: "Least-cost & debit routing", d: "Route on real card type and regulated-debit flags." },
  { t: "Surcharging & interchange", d: "Price correctly with consumer/commercial certainty." },
  { t: "DCC eligibility (EU)", d: "Offer compliant conversion with ECB-rate disclosure." },
  { t: "Checkout UX & card art", d: "Show the right scheme logo the moment a BIN is typed." },
  { t: "Fraud & risk signals", d: "Flag issuer-country mismatches and prepaid cards." },
  { t: "Batch enrichment", d: "Backfill historical data with versioned BIN records." },
];
/**
 * SoftwareApplication structured data (§8). Deliberately claims nothing the
 * pages don't: no rating, no review count, no price. `offers` is omitted rather
 * than faked — pricing is contact-driven, and an invented price would breach the
 * honesty constraint above.
 */
const productLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  applicationCategory: "BusinessApplication",
  description: PRODUCT_DESCRIPTION,
  operatingSystem: "Self-hosted (Linux container), managed cloud, or BYOL",
  url: new URL(PRODUCT_PATH, Astro.site).href,
  publisher: { "@id": new URL("#organization", Astro.site).href },
};
---

<Layout
  title="Product — FindThisBIN BIN intelligence engine"
  description={PRODUCT_DESCRIPTION}
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} is:inline />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-wrap">
      <span class="hero-pill">
        <span class="dot" aria-hidden="true"></span>
        Product
      </span>
      <h1 class="h1 hero-h1">
        The card-intelligence layer for <span class="grad-text">payment platforms.</span>
      </h1>
      <p class="lead hero-lead">
        Deploy the engine in your own cloud, plug in your data licenses, and turn any 6–8 digit BIN
        into a complete, typed, scored card record — so your platform can route, price, comply, and
        protect with confidence.
      </p>
      <div class="cta-row hero-cta">
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" size="lg" />
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="ghost-dark" size="lg" />
      </div>
    </div>
  </section>

  <!-- ============ ANATOMY OF A LOOKUP ============ -->
  <section class="band band-white">
    <div class="wrap">
      <div class="two-col">
        <div data-reveal>
          <Eyebrow label="Anatomy of a lookup" tone="violet" />
          <h2 class="h2">One request in. A complete card record out.</h2>
          <p class="lead">
            Send a BIN to the engine running in your environment, get back every attribute your
            stack needs — each one typed, versioned, and carrying its own confidence score. No
            stitching together raw network files.
          </p>
          <div class="anatomy">
            {
              lookupFields.map((f) => (
                <div class="anatomy-row">
                  <span class="anatomy-arrow" aria-hidden="true">→</span>
                  <p class="anatomy-text">
                    <span class="anatomy-k">{f.k}:</span> {f.d}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
        <div data-reveal>
          <CodeTabs
            id="anatomy"
            tabs={responseTab}
            headLabel="findthisbin-engine · your-cloud"
            method="GET"
            url={`${ENGINE_BASE_URL}/v1/bins/53847012`}
            footer="→ 200 OK"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITIES ============ -->
  <section class="band band-off">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="Capabilities" tone="violet" />
        <h2 class="h2">Four things we obsess over.</h2>
      </div>
      <div class="pillars" data-reveal>
        <article class="pillar dark">
          <div class="pillar-glow glow-violet" aria-hidden="true"></div>
          <div class="pillar-body">
            <div class="pillar-eyebrow lime">01 · DEPLOY IN YOUR CLOUD</div>
            <h3 class="h3">Run it where your data lives.</h3>
            <p class="pillar-text">Self-host in your cloud, VPC, or on-prem — or have us operate it for you. Your engineers then integrate a clean REST API with idiomatic SDKs in 5 languages.</p>
            <pre class="mini-code mono"><code><span class="kw">await</span> ftb<span class="pn">.</span><span class="fn">bins</span><span class="pn">.</span><span class="fn">get</span><span class="pn">(</span><span class="st">'53847012'</span><span class="pn">)</span></code></pre>
          </div>
        </article>

        <article class="pillar light">
          <div class="pillar-eyebrow violet">02 · EU &amp; COMPLIANCE</div>
          <h3 class="h3 ink">Compliant by construction.</h3>
          <p class="pillar-text light">Hosted in the EU, GDPR-clean, and entirely out of PCI scope — we only ever see the BIN, never a full PAN. The built-in DCC module ships ECB reference-rate disclosure for PSD2 / CBPR.</p>
          <div class="chips">
            {["EU-hosted", "GDPR-clean", "PCI out-of-scope", "DPA available"].map((c) => <span class="chip">{c}</span>)}
          </div>
        </article>

        <article class="pillar light">
          <div class="pillar-eyebrow violet">03 · ACCURACY</div>
          <h3 class="h3 ink">8-digit precision, not guesswork.</h3>
          <p class="pillar-text light">True 8-digit range resolution, multi-source aggregation, and continuous corrections — catching the mislabeled prepaid and commercial cards that raw network files miss. Every field carries its own confidence.</p>
          <div class="accuracy-stat">
            <div class="big-8">per-field</div>
            <div class="big-8-sub">confidence on<br />every attribute</div>
          </div>
        </article>

        <article class="pillar dark">
          <div class="pillar-glow glow-cyan glow-bl" aria-hidden="true"></div>
          <div class="pillar-body">
            <div class="pillar-eyebrow cyan">04 · PERFORMANCE</div>
            <h3 class="h3">Fast enough for the hot path.</h3>
            <p class="pillar-text">Sub-10ms p99 lookups that absorb BIN-enumeration bursts, so you can call us inline at checkout without adding latency.</p>
            <div class="perf-mini">
              <div><div class="perf-n">&lt;10ms</div><div class="perf-l">p99 latency</div></div>
              <div><div class="perf-n">99.9%</div><div class="perf-l">uptime</div></div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </section>

  <!-- ============ ENDPOINTS ============ -->
  <section class="band band-ink endpoints">
    <div class="endpoints-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="Endpoints" tone="cyan" />
        <h2 class="h2 on-dark">Three endpoints. Everything you need.</h2>
      </div>
      <div class="endpoint-grid" data-reveal>
        {
          endpoints.map((e) => (
            <div class="endpoint-card">
              <div class="endpoint-route mono">
                <span class:list={["verb", e.tone]}>{e.verb}</span>
                <span class="path">{e.path}</span>
              </div>
              <h3 class="endpoint-t">{e.t}</h3>
              <p class="endpoint-d">{e.d}</p>
            </div>
          ))
        }
      </div>

    </div>
  </section>

  <!-- ============ FITS YOUR STACK ============ -->
  <section class="band band-white">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2 usecases-h2">Plugs into every decision in your flow.</h2>
        <p class="lead">The same record powers routing, pricing, compliance, UX, and risk — no separate integrations.</p>
      </div>
      <div class="usecases" data-reveal>
        {
          useCases.map((u) => (
            <div class="usecase">
              <div class="usecase-t">{u.t}</div>
              <div class="usecase-d">{u.d}</div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <section class="final">
    <div class="final-blob" aria-hidden="true"></div>
    <div class="wrap wrap-tight final-wrap">
      <h2 class="h1-page final-h2" data-reveal>See it on your own BINs.</h2>
      <p class="final-lead" data-reveal>Book a walkthrough and we’ll scope a proof-of-concept deployed in your environment — live in days, not quarters.</p>
      <div class="cta-row center final-cta" data-reveal>
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" size="lg" />
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="ghost-dark" size="lg" />
      </div>
    </div>
  </section>
</Layout>

<style>
  /* ── Hero (centered) ──────────────────────────────────────────────── */
  .hero { position: relative; background: var(--ink); overflow: hidden; }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 80% at 75% -10%, color-mix(in srgb, var(--violet) 28%, transparent), color-mix(in srgb, var(--ink) 0%, transparent) 55%),
      radial-gradient(70% 60% at 6% 8%, color-mix(in srgb, var(--cyan) 14%, transparent), color-mix(in srgb, var(--ink) 0%, transparent) 52%);
  }
  .hero-wrap {
    padding-top: clamp(52px, 7vw, 96px);
    padding-bottom: clamp(48px, 6vw, 76px);
    position: relative;
    z-index: 1;
    text-align: center;
    max-width: 900px;
  }
  .hero-pill {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: 7px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    margin-bottom: 24px;
    font-size: 13px;
    font-weight: 600;
    color: var(--text-dark-bright);
  }
  .hero-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--lime);
    box-shadow: 0 0 10px var(--lime);
  }
  .hero-h1 { margin: 0 auto 20px; max-width: 880px; }
  .hero-lead { color: var(--text-dark-body); margin: 0 auto 32px; max-width: 620px; }
  .hero-cta { justify-content: center; }

  /* ── Section heads ────────────────────────────────────────────────── */
  .section-head { max-width: 680px; margin-bottom: 44px; }
  .section-head .h2 { margin-top: 14px; }
  .on-dark { color: var(--white); }

  /* ── Two-column (anatomy) ─────────────────────────────────────────── */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: center; }
  @media (max-width: 900px) { .two-col { grid-template-columns: 1fr; gap: 36px; } }
  .two-col .h2 { margin-top: 14px; }
  .anatomy { display: flex; flex-direction: column; gap: 14px; margin-top: 24px; }
  .anatomy-row { display: flex; gap: 13px; align-items: flex-start; }
  .anatomy-arrow { flex: none; color: var(--violet); font-weight: 700; line-height: 1.55; }
  .anatomy-text { margin: 0; font-size: 16px; line-height: 1.55; color: var(--text-light-body); }
  .anatomy-k { font-weight: 600; color: var(--ink); }

  /* ── Pillars ──────────────────────────────────────────────────────── */
  .pillars { display: grid; grid-template-columns: 1fr 1fr; gap: 22px; }
  .pillar { border-radius: 18px; padding: 34px; position: relative; overflow: hidden; }
  .pillar.dark { background: var(--ink); color: var(--white); }
  .pillar.light { background: var(--white); border: 1px solid var(--border-light); }
  .pillar-body { position: relative; z-index: 1; }
  .pillar-glow { position: absolute; width: 180px; height: 180px; filter: blur(10px); }
  .glow-violet { top: -40px; right: -40px; background: radial-gradient(circle, color-mix(in srgb, var(--violet) 40%, transparent), transparent 70%); }
  .glow-cyan { background: radial-gradient(circle, color-mix(in srgb, var(--cyan) 35%, transparent), transparent 70%); }
  .glow-bl { bottom: -40px; left: -40px; }
  .pillar-eyebrow { font-size: 13px; font-weight: 700; letter-spacing: 0.05em; margin-bottom: 14px; }
  .pillar-eyebrow.lime { color: var(--lime); }
  .pillar-eyebrow.violet { color: var(--violet); }
  .pillar-eyebrow.cyan { color: var(--cyan); }
  .h3.ink { color: var(--ink); }
  .pillar-text { font-size: 15.5px; line-height: 1.6; color: var(--text-dark-body); margin: 0 0 22px; }
  .pillar-text.light { color: var(--text-light-body); margin-bottom: 20px; }
  .mini-code {
    background: var(--ink-black);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 14px;
    font-size: 12.5px;
    line-height: 1.7;
    margin: 0;
    overflow-x: auto;
    white-space: pre;
  }
  .mini-code .kw { color: var(--code-keyword); }
  .mini-code .fn { color: var(--code-function); }
  .mini-code .st { color: var(--code-string); }
  .mini-code .pn { color: var(--code-punct); }
  .chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .chip {
    font-size: 12.5px;
    font-weight: 600;
    color: var(--ink);
    background: var(--off-white);
    border: 1px solid var(--border-light);
    padding: 6px 11px;
    border-radius: 8px;
  }
  .accuracy-stat { margin-top: 20px; display: flex; align-items: center; gap: 14px; }
  .big-8 { font-family: var(--font-display); font-weight: 700; font-size: 36px; color: var(--ink); letter-spacing: -0.03em; }
  .big-8-sub { font-size: 13.5px; color: var(--text-light-muted); line-height: 1.4; }
  .perf-mini { display: flex; gap: 28px; }
  .perf-n { font-family: var(--font-display); font-weight: 700; font-size: 30px; color: var(--lime); }
  .perf-l { font-size: 13px; color: var(--text-dark-muted-2); }
  @media (max-width: 820px) { .pillars { grid-template-columns: 1fr; } }

  /* ── Endpoints ────────────────────────────────────────────────────── */
  .endpoints { position: relative; }
  .endpoints-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(80% 70% at 88% 12%, color-mix(in srgb, var(--cyan) 16%, transparent), transparent 55%);
  }
  .endpoints .wrap { position: relative; z-index: 1; }
  .endpoint-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 820px) { .endpoint-grid { grid-template-columns: 1fr; } }
  .endpoint-card {
    background: var(--ink-2);
    border: 1px solid var(--border-dark);
    border-radius: 16px;
    padding: 26px;
  }
  .endpoint-route { display: flex; align-items: center; gap: 9px; margin-bottom: 16px; }
  .endpoint-route .verb {
    font-weight: 700;
    color: var(--ink);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
  }
  .endpoint-route .verb.cyan { background: var(--cyan); }
  .endpoint-route .verb.lime { background: var(--lime); }
  .endpoint-route .path { font-size: 12.5px; color: var(--text-dark-soft); }
  .endpoint-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; margin: 0 0 8px; color: var(--white); }
  .endpoint-d { font-size: 14px; line-height: 1.55; color: var(--text-dark-muted); margin: 0; }


  /* ── Fits your stack (use cases) ──────────────────────────────────── */
  .usecases-h2 { max-width: 600px; }
  .usecases { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .usecase { border: 1px solid var(--border-light); border-radius: 14px; padding: 22px; transition: border-color 0.15s ease; }
  .usecase:hover { border-color: var(--violet); }
  .usecase-t { font-family: var(--font-display); font-weight: 700; font-size: 17px; margin-bottom: 6px; }
  .usecase-d { font-size: 14px; color: var(--text-light-body); line-height: 1.55; }

  /* ── Final CTA ────────────────────────────────────────────────────── */
  .final {
    position: relative;
    overflow: hidden;
    background: linear-gradient(125deg, var(--ink) 0%, var(--violet-deep) 45%, var(--blue) 130%);
  }
  .final-blob {
    position: absolute;
    top: -100px;
    left: 30%;
    width: 500px;
    height: 500px;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--violet) 50%, transparent), transparent 65%);
    filter: blur(30px);
    pointer-events: none;
  }
  .final-wrap {
    padding-top: clamp(72px, 10vw, 128px);
    padding-bottom: clamp(72px, 10vw, 128px);
    text-align: center;
    position: relative;
    z-index: 1;
  }
  .final-h2 { color: var(--white); margin-bottom: 22px; }
  .final-lead {
    font-size: 18px;
    line-height: 1.6;
    color: var(--text-dark-soft);
    margin: 0 auto 34px;
    max-width: 520px;
  }
  .final-cta { justify-content: center; }
</style>
