---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import CodeTabs from "../components/CodeTabs.astro";
import FinalCta from "../components/FinalCta.astro";
import type { CodeTab } from "../components/CodeTabs.astro";
import {
  SITE_NAME,
  PRODUCT_PATH,
  BOOK_DEMO_LABEL,
  BOOK_DEMO_URL,
  TALK_TO_SALES_LABEL,
  TALK_TO_SALES_URL,
  ENGINE_BASE_URL,
} from "../lib/site";

const PRODUCT_DESCRIPTION =
  "Deploy the BIN intelligence engine in your own cloud, plug in your data licenses, and turn any 6–8 digit BIN into a complete, typed, scored card record — scheme, type, issuer, country, currency, DCC eligibility, and confidence. EU-hosted option, out of PCI scope, sub-10ms p99.";

const lookupFields = [
  { k: "Identity", d: "scheme, type, category, product / card level." },
  { k: "Issuer", d: "name, country, and settlement currency." },
  { k: "Flags & DCC", d: "prepaid, commercial, regulated-debit, DCC eligibility." },
  { k: "Provenance", d: "per-field confidence and dataset version." },
];

const responseTab: CodeTab[] = [
  {
    label: "Response",
    lang: "json",
    code: `{
  "bin": "53847012",
  "scheme": "mastercard",
  "type": "credit",
  "category": "consumer",
  "product": "World Elite Mastercard",
  "issuer": { "name": "Revolut Ltd", "country": "GB", "currency": "GBP" },
  "flags": { "prepaid": false, "commercial": false },
  "dcc_eligible": true,
  "confidence": 0.98,
  "dataset_version": "2026-06-12"
}`,
  },
];

/* The spec sheet — every number here is an inline claim the site already makes
   (sub-10ms p99, 99.9% uptime, 8-digit, EU residency). No invented scale. */
const specTiles = [
  { n: "<10ms", l: "p99 lookup latency", d: "Safe to call inline at checkout, even through BIN-enumeration bursts." },
  { n: "99.9%", l: "uptime target", d: "Backed by the SLA on managed deployment models." },
  { n: "8-digit", l: "range precision", d: "Catches the prepaid and commercial cards 6-digit tables mislabel." },
  { n: "EU", l: "residency option", d: "Hosted in the EU, GDPR-clean, per-customer DPA." },
];

const specGroups = [
  {
    t: "Deployment",
    items: ["Self-hosted / BYOC — air-gappable", "Managed in your cloud", "Fully managed (BYOL)"],
  },
  {
    t: "Data quality",
    items: ["8-digit range resolution", "Multi-source merge & corrections", "Per-field confidence scores", "Versioned datasets"],
  },
  {
    t: "Compliance",
    items: ["Out of PCI scope — BINs only", "GDPR-clean, DPA available", "EU-hosting option", "SOC 2 in progress"],
  },
];

const endpoints = [
  {
    verb: "GET",
    tone: "cyan",
    path: "/v1/bins/{bin}",
    t: "Single lookup",
    d: "The core endpoint — one BIN, the full card-intelligence record in milliseconds.",
  },
  {
    verb: "POST",
    tone: "lime",
    path: "/v1/bins/batch",
    t: "Batch lookup",
    d: "Enrich up to 10,000 BINs per call — perfect for backfilling transaction tables.",
  },
  {
    verb: "GET",
    tone: "cyan",
    path: "/v1/dcc/{bin}",
    t: "DCC disclosure",
    d: "DCC eligibility with ECB reference-rate data points for PSD2 / CBPR compliance.",
  },
];

/* The payment lifecycle — the six use cases mapped to where they fire. */
const flow = [
  { n: "01", step: "Authorize", t: "Fraud & risk signals", d: "Flag issuer-country mismatches and prepaid cards in your risk engine." },
  { n: "02", step: "Route", t: "Least-cost & debit routing", d: "Route on real card type and regulated-debit flags." },
  { n: "03", step: "Price", t: "Surcharging & DCC", d: "Apply correct surcharges; offer compliant DCC with ECB-rate disclosure." },
  { n: "04", step: "Present", t: "Checkout UX & card art", d: "Show the right card art and scheme label as the BIN is typed." },
  { n: "05", step: "Analyze", t: "Batch enrichment", d: "Backfill historical tables with versioned BIN records." },
];
/**
 * SoftwareApplication structured data (§8). Deliberately claims nothing the
 * pages don't: no rating, no review count, no price. `offers` is omitted rather
 * than faked — pricing is contact-driven, and an invented price would breach the
 * honesty constraint above.
 */
const productLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: SITE_NAME,
  applicationCategory: "BusinessApplication",
  description: PRODUCT_DESCRIPTION,
  operatingSystem: "Self-hosted (Linux container), managed cloud, or BYOL",
  url: new URL(PRODUCT_PATH, Astro.site).href,
  publisher: { "@id": new URL("#organization", Astro.site).href },
};
---

<Layout
  title="Product — FindThisBIN BIN intelligence engine"
  description={PRODUCT_DESCRIPTION}
>
  <script type="application/ld+json" set:html={JSON.stringify(productLd)} is:inline />

  <!-- ============ HERO — the API is the product ============ -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-wrap">
      <span class="pill">
        <span class="dot" aria-hidden="true"></span>
        Product
      </span>
      <h1 class="h1 hero-h1">
        The card-intelligence layer for <span class="grad-text">payment platforms.</span>
      </h1>
      <p class="lead hero-lead">
        Deploy the engine in your own cloud, plug in your data licenses, and turn any 6–8 digit BIN
        into a complete, typed, scored card record — so your platform can route, price, comply, and
        protect with confidence.
      </p>
      <div class="cta-row hero-cta">
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" size="lg" />
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="ghost-dark" size="lg" />
      </div>
      <div class="req-bar" data-reveal>
        <span class="req-verb">GET</span>
        <span class="req-url mono">https://bins.internal/v1/bins/<span class="bin">53847012</span><span class="caret" aria-hidden="true"></span></span>
        <span class="req-status mono">→ 200 OK · sub-10ms</span>
      </div>
    </div>
  </section>

  <!-- ============ ANATOMY OF A LOOKUP ============ -->
  <section class="band band-white">
    <div class="wrap">
      <div class="two-col">
        <div data-reveal>
          <Eyebrow label="Anatomy of a lookup" tone="violet" />
          <h2 class="h2">One request in. A complete card record out.</h2>
          <p class="lead">
            Send a BIN to the engine running in your environment, get back every attribute your
            stack needs — each one typed, versioned, and carrying its own confidence score. No
            stitching together raw network files.
          </p>
          <div class="anatomy">
            {
              lookupFields.map((f) => (
                <div class="anatomy-row">
                  <span class="anatomy-arrow" aria-hidden="true">→</span>
                  <p class="anatomy-text">
                    <span class="anatomy-k">{f.k}:</span> {f.d}
                  </p>
                </div>
              ))
            }
          </div>
        </div>
        <div data-reveal>
          <CodeTabs
            id="anatomy"
            tabs={responseTab}
            headLabel="findthisbin-engine · your-cloud"
            method="GET"
            url={`${ENGINE_BASE_URL}/v1/bins/53847012`}
            footer={`→ 200 OK · scheme: "mastercard" · confidence: 0.98`}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ SPEC SHEET ============ -->
  <section class="band band-off">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Four things we obsess over.</h2>
        <p class="lead">The numbers we run the engine by — and what they mean for your integration.</p>
      </div>
      <div class="spec-tiles" data-reveal>
        {
          specTiles.map((s) => (
            <div class="spec-tile">
              <div class="spec-n">{s.n}</div>
              <div class="spec-l mono">{s.l}</div>
              <p class="spec-d">{s.d}</p>
            </div>
          ))
        }
      </div>
      <div class="spec-groups" data-reveal>
        {
          specGroups.map((g) => (
            <div class="spec-group">
              <h3 class="spec-group-t mono">{g.t}</h3>
              <ul>
                {g.items.map((i) => <li><span class="spec-check" aria-hidden="true">✓</span>{i}</li>)}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ENDPOINTS ============ -->
  <section class="band band-ink endpoints">
    <div class="endpoints-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <Eyebrow label="Endpoints" tone="cyan" />
        <h2 class="h2 on-dark">Three endpoints. Everything you need.</h2>
      </div>
      <div class="endpoint-grid" data-reveal>
        {
          endpoints.map((e) => (
            <div class="endpoint-card">
              <div class="endpoint-route mono">
                <span class:list={["verb", e.tone]}>{e.verb}</span>
                <span class="path">{e.path}</span>
              </div>
              <h3 class="endpoint-t">{e.t}</h3>
              <p class="endpoint-d">{e.d}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ FITS YOUR STACK — payment-flow stepper ============ -->
  <section class="band band-white">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">Plugs into every decision in your flow.</h2>
        <p class="lead">One record powers the whole payment lifecycle — no separate integrations.</p>
      </div>
      <ol class="flow" data-reveal>
        {
          flow.map((f) => (
            <li class="flow-step">
              <div class="flow-node mono">{f.n}</div>
              <div class="flow-step-name mono">{f.step}</div>
              <div class="flow-t">{f.t}</div>
              <p class="flow-d">{f.d}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <FinalCta
    heading="See it on your own BINs."
    lead="Book a walkthrough and we’ll scope a proof-of-concept deployed in your environment — live in days, not quarters."
  />
</Layout>

<style>
  /* ── Hero (left-aligned; the request line is the visual) ──────────── */
  .hero { position: relative; background: var(--ink); overflow: hidden; }
  .hero-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(110% 80% at 75% -10%, color-mix(in srgb, var(--violet) 28%, transparent), color-mix(in srgb, var(--ink) 0%, transparent) 55%),
      radial-gradient(70% 60% at 6% 8%, color-mix(in srgb, var(--cyan) 14%, transparent), color-mix(in srgb, var(--ink) 0%, transparent) 52%);
  }
  .hero-wrap {
    padding-top: clamp(52px, 7vw, 96px);
    padding-bottom: clamp(56px, 7vw, 88px);
    position: relative;
    z-index: 1;
  }
  .hero .pill { margin-bottom: 24px; }
  .hero-h1 { margin: 0 0 20px; max-width: 880px; }
  .hero-lead { color: var(--text-dark-body); margin: 0 0 32px; max-width: 620px; }
  .hero-cta { margin-bottom: 44px; }

  /* The one-call request bar — the product's handshake, at hero scale. */
  .req-bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 14px;
    max-width: 860px;
    background: var(--ink-2);
    border: 1px solid var(--border-dark);
    border-radius: 14px;
    padding: 18px 20px;
    box-shadow: var(--shadow-panel);
  }
  .req-verb {
    flex: none;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 13px;
    color: var(--ink);
    background: var(--lime);
    padding: 4px 10px;
    border-radius: 6px;
  }
  .req-url {
    font-size: clamp(13px, 1.9vw, 16.5px);
    color: var(--text-dark-body);
    word-break: break-all;
  }
  .req-url .bin { color: var(--cyan); }
  .caret {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    margin-left: 6px;
    vertical-align: text-bottom;
    background: var(--lime);
    animation: ftbBlink 1s step-end infinite;
  }
  .req-status {
    margin-left: auto;
    flex: none;
    font-size: 12.5px;
    color: var(--check-green);
  }
  @media (max-width: 640px) {
    .req-status { margin-left: 0; width: 100%; }
  }

  /* ── Two-column (anatomy) ─────────────────────────────────────────── */
  .two-col { gap: 40px; }
  .two-col .h2 { margin-top: 14px; }
  .anatomy { display: flex; flex-direction: column; gap: 14px; margin-top: 24px; }
  .anatomy-row { display: flex; gap: 13px; align-items: flex-start; }
  .anatomy-arrow { flex: none; color: var(--violet); font-weight: 700; line-height: 1.55; }
  .anatomy-text { margin: 0; font-size: 16px; line-height: 1.55; color: var(--text-light-body); }
  .anatomy-k { font-weight: 600; color: var(--ink); }

  /* ── Spec sheet ───────────────────────────────────────────────────── */
  .spec-tiles {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .spec-tile {
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 24px;
  }
  .spec-n {
    font-family: var(--font-display);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-size: clamp(30px, 3.4vw, 42px);
    color: var(--ink);
    margin-bottom: 10px;
  }
  .spec-l {
    font-size: 11.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet);
    margin-bottom: 10px;
  }
  .spec-d { font-size: 13.5px; line-height: 1.55; color: var(--text-light-body); margin: 0; }
  @media (max-width: 980px) { .spec-tiles { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .spec-tiles { grid-template-columns: 1fr; } }

  .spec-groups {
    margin-top: 36px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 28px;
  }
  .spec-group { border-top: 2px solid var(--violet); padding-top: 16px; }
  .spec-group-t {
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light-muted);
    margin: 0 0 14px;
  }
  .spec-group ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .spec-group li { display: flex; gap: 10px; font-size: 14.5px; line-height: 1.5; color: var(--text-light-body-strong); }
  .spec-check { flex: none; font-weight: 700; color: var(--lime-deep); }
  @media (max-width: 820px) { .spec-groups { grid-template-columns: 1fr; gap: 24px; } }

  /* ── Endpoints ────────────────────────────────────────────────────── */
  .endpoints { position: relative; }
  .endpoints-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(80% 70% at 88% 12%, color-mix(in srgb, var(--cyan) 16%, transparent), transparent 55%);
  }
  .endpoints .wrap { position: relative; z-index: 1; }
  .endpoint-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
  @media (max-width: 820px) { .endpoint-grid { grid-template-columns: 1fr; } }
  .endpoint-card {
    background: var(--ink-2);
    border: 1px solid var(--border-dark);
    border-radius: 16px;
    padding: 26px;
  }
  .endpoint-route { display: flex; align-items: center; gap: 9px; margin-bottom: 16px; }
  .endpoint-route .verb {
    font-weight: 700;
    color: var(--ink);
    padding: 2px 8px;
    border-radius: 6px;
    font-size: 11px;
  }
  .endpoint-route .verb.cyan { background: var(--cyan); }
  .endpoint-route .verb.lime { background: var(--lime); }
  .endpoint-route .path { font-size: 12.5px; color: var(--text-dark-soft); }
  .endpoint-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; margin: 0 0 8px; color: var(--white); }
  .endpoint-d { font-size: 14px; line-height: 1.55; color: var(--text-dark-muted); margin: 0; }

  /* ── Flow stepper (payment lifecycle) ─────────────────────────────── */
  .flow {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 20px;
  }
  .flow-step {
    position: relative;
    border-top: 1px solid var(--border-light);
    padding-top: 22px;
  }
  .flow-node {
    position: absolute;
    top: -1px;
    left: 0;
    /* cover the rail with a node chip */
    transform: translateY(-50%);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 24px;
    padding: 0 8px;
    border-radius: 7px;
    font-size: 11px;
    color: var(--violet);
    background: var(--white);
    border: 1px solid color-mix(in srgb, var(--violet) 45%, transparent);
  }
  .flow-step-name {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-light-faint);
    margin-bottom: 8px;
  }
  .flow-t { font-family: var(--font-display); font-weight: 700; font-size: 17px; margin-bottom: 6px; }
  .flow-d { font-size: 13.5px; color: var(--text-light-body); line-height: 1.55; margin: 0; }
  @media (max-width: 980px) {
    .flow { grid-template-columns: 1fr; gap: 0; }
    .flow-step {
      border-top: 0;
      border-left: 1px solid var(--border-light);
      padding: 0 0 26px 26px;
    }
    .flow-step:last-child { padding-bottom: 0; }
    .flow-node { top: 0; left: 0; transform: translateX(-50%); }
  }
</style>
