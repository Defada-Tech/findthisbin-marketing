---
import Layout from "../layouts/Layout.astro";
import Eyebrow from "../components/Eyebrow.astro";
import Button from "../components/Button.astro";
import FinalCta from "../components/FinalCta.astro";
import {
  BOOK_DEMO_LABEL,
  BOOK_DEMO_URL,
  TALK_TO_SALES_LABEL,
  TALK_TO_SALES_URL,
} from "../lib/site";

/* The capability atlas — this page's own identity (it was built from the
   Pricing prototype and read as "pricing without prices"). Glyph chips instead
   of an icon set: mono glyphs are the brand's native texture. */
const atlas = [
  {
    glyph: "▸",
    tone: "cyan",
    wide: true,
    t: "Lookup & batch",
    d: "One BIN in, a complete typed record out — or ten thousand in a single POST.",
  },
  {
    glyph: "€$",
    tone: "violet",
    t: "DCC eligibility",
    d: "Compliant dynamic currency conversion with ECB reference-rate disclosure, ready for PSD2 / CBPR.",
  },
  {
    glyph: "⊞",
    tone: "violet",
    t: "Flags & regulation",
    d: "Prepaid, commercial, and regulated-debit certainty for routing and surcharging decisions.",
  },
  {
    glyph: "∿",
    tone: "cyan",
    t: "Confidence & provenance",
    d: "Every field carries its own confidence score and dataset version. No silent guesses.",
  },
  {
    glyph: "⇲",
    tone: "lime",
    tint: true,
    t: "Connectors & seed data",
    d: "Visa VBASS, the Mastercard BIN table, commercial feeds, or your own CSV — with bundled seed data for day one.",
  },
];

const deployModels = [
  {
    name: "Self-hosted / BYOC",
    chip: "self-hosted",
    text: "Run it in your own cloud, VPC, or on-prem — air-gappable. Your infrastructure, your data, your control.",
    checks: ["Deploy via Helm / container", "Nothing leaves your network", "You operate the ops"],
    highlight: false,
  },
  {
    name: "Managed in your cloud",
    chip: "most popular",
    text: "We deploy and operate the engine inside your environment. You keep the data; we keep it running.",
    checks: ["Runs in your VPC / account", "We handle upgrades & ops", "Data residency stays yours"],
    highlight: true,
  },
  {
    name: "Fully managed (BYOL)",
    chip: "fully managed",
    text: "We host and operate it; you onboard as an isolated tenant and bring your licenses. Zero infra, zero ops — your data stays isolated and yours.",
    checks: ["Isolated per-tenant data", "Bring your own licenses", "No infrastructure to manage"],
    highlight: false,
  },
];

const cols = ["Self-hosted", "Managed in your cloud", "Fully managed"];
/* Real capabilities only — the old table opened with three self-referential
   rows ("Self-hosted / BYOC: ✓/✓/✓"). SOC 2 is "Roadmap" in every column: it is
   in progress company-wide, so no model may show a check. */
const rows: { label: string; cells: string[] }[] = [
  { label: "8-digit range data + confidence", cells: ["✓", "✓", "✓"] },
  { label: "Bundled seed data", cells: ["✓", "✓", "✓"] },
  { label: "Included connectors", cells: ["Base", "Extended", "Premium"] },
  { label: "DCC module", cells: ["—", "✓", "✓"] },
  { label: "Surcharging & interchange intelligence", cells: ["—", "✓", "✓"] },
  { label: "Network-token indicators", cells: ["—", "✓", "✓"] },
  { label: "Air-gappable install", cells: ["✓", "—", "—"] },
  { label: "Data stays in your environment", cells: ["✓", "✓", "✓"] },
  { label: "Managed operations", cells: ["—", "Optional", "✓"] },
  { label: "Uptime SLA", cells: ["—", "99.9%", "Custom"] },
  { label: "Support level", cells: ["Community", "Standard", "Dedicated"] },
  { label: "Dataset export", cells: ["—", "—", "✓"] },
  { label: "DPA", cells: ["✓", "✓", "✓"] },
  { label: "SOC 2", cells: ["Roadmap", "Roadmap", "Roadmap"] },
];

const faqs = [
  { q: "What deployment options are there?", a: "Three, all running the same engine: self-hosted in your own cloud / VPC / on-prem, managed by us inside your cloud, or fully managed where we host an isolated tenant for you." },
  { q: "Where does my data live?", a: "In your environment. For self-hosted and managed-in-your-cloud, nothing leaves your VPC. The fully-managed option keeps your data isolated per tenant, with an EU-hosting option." },
  { q: "Do you ever see my card data?", a: "No. The engine only ever works with the 6–8 digit BIN — we are out of PCI scope and out of the card/data path entirely." },
  { q: "Can you host it for us?", a: "Yes. Choose managed-in-your-cloud (we operate it inside your account) or fully-managed (we host an isolated tenant). Either way you keep ownership of your data." },
  { q: "What licenses do I need to bring?", a: "Connect what you license — Visa VBASS, the Mastercard BIN table, commercial providers, or your own CSV. It works on day one with bundled open seed data, and we'll help you connect to providers if you don't have a license yet." },
  { q: "How do I evaluate it?", a: "With a proof-of-concept deployed in your own cloud using bundled seed data — connect a source and run it against your real BINs before committing." },
  { q: "How is it priced?", a: "By deployment model, volume, connectors, and SLA rather than per-lookup. Tell us your setup and we'll scope a plan." },
  { q: "Can I run it air-gapped / on-prem?", a: "Yes — the self-hosted model is air-gappable, and Enterprise adds dataset export for fully isolated environments." },
];

const cellKind = (c: string) => (c === "✓" ? "check" : c === "—" ? "dash" : "text");
---

<Layout
  title="Features — FindThisBIN"
  description="Every capability of the FindThisBIN engine — lookups, batch, DCC, flags, and per-field confidence — and the three deployment models it runs under. Compare options and book a demo."
>
  <!-- ============ HEADER ============ -->
  <section class="header">
    <div class="header-bg" aria-hidden="true"></div>
    <div class="wrap wrap-narrow header-wrap">
      <div class="header-eyebrow">
        <Eyebrow label="// features" mono tone="violet" />
      </div>
      <h1 class="h1-page">One engine, every capability.</h1>
      <p class="header-lead">
        Everything below runs in your environment, on your licenses — self-hosted, managed in
        your cloud, or fully managed. Same engine either way.
      </p>
      <div class="cta-row center header-cta">
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" size="lg" />
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="ghost-dark" size="lg" />
      </div>
    </div>
  </section>

  <!-- ============ CAPABILITY ATLAS ============ -->
  <section class="band band-white">
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2">What the engine does.</h2>
        <p class="lead">Five capabilities, one deployment, your cloud.</p>
      </div>
      <div class="atlas" data-reveal>
        {
          atlas.map((c) => (
            <article class:list={["cell", c.wide && "wide", c.tint && "tint"]}>
              <span class:list={["glyph", c.tone]} aria-hidden="true">{c.glyph}</span>
              <h3 class="cell-t">{c.t}</h3>
              <p class="cell-d">{c.d}</p>
              {c.wide && (
                <pre class="cell-code mono"><code><span class="v-get">GET</span>  /v1/bins/53847012   <span class="cm">→ one record</span>
<span class="v-post">POST</span> /v1/bins/batch      <span class="cm">→ up to 10,000</span></code></pre>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ DEPLOYMENT OPTIONS ============ -->
  <section id="tiers" class="band band-ink deploy">
    <div class="deploy-bg" aria-hidden="true"></div>
    <div class="wrap">
      <div class="section-head" data-reveal>
        <h2 class="h2 on-dark">Three ways to run it.</h2>
        <p class="lead on-dark">Same engine either way — you choose who keeps the lights on.</p>
      </div>
      <div class="deploy-rows" data-reveal>
        {
          deployModels.map((m) => (
            <article class:list={["deploy-row", m.highlight && "highlight"]}>
              <div class="deploy-main">
                <span class="deploy-chip">{m.chip}</span>
                <h3 class="deploy-name">{m.name}</h3>
                <p class="deploy-text">{m.text}</p>
              </div>
              <ul class="deploy-checks">
                {m.checks.map((c) => (
                  <li><span class="check" aria-hidden="true">✓</span>{c}</li>
                ))}
              </ul>
            </article>
          ))
        }
      </div>
      <div class="cta-row deploy-cta" data-reveal>
        <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" />
      </div>
    </div>
  </section>

  <!-- ============ COMPARISON TABLE ============ -->
  <section class="band band-off">
    <div class="wrap">
      <h2 class="h2 center-h2" data-reveal>Compare deployment options</h2>
      <div class="cmp" data-reveal>
        <table>
          <thead>
            <tr>
              <th class="feature-col">Capability</th>
              {cols.map((c) => <th class:list={[c === "Managed in your cloud" && "growth-col"]}>{c}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              rows.map((row) => (
                <tr>
                  <td class="feature-cell">{row.label}</td>
                  {
                    row.cells.map((c) => (
                      <td class="c">
                        {cellKind(c) === "check" && <span class="ck">✓</span>}
                        {cellKind(c) === "dash" && <span class="dash">—</span>}
                        {cellKind(c) === "text" && <span class="txt">{c}</span>}
                      </td>
                    ))
                  }
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- ============ POC CALLOUT ============ -->
  <section class="band band-white poc-band">
    <div class="wrap wrap-narrow">
      <div class="poc" data-reveal>
        <span class="poc-tag mono">Proof of concept</span>
        <h2 class="h2 poc-h2">Evaluate with a POC in your own cloud.</h2>
        <p class="poc-p">
          Stand up the engine in your environment with bundled seed data, then connect a source and
          run it against your own BINs — before you commit.
        </p>
        <div class="cta-row poc-cta">
          <Button href={BOOK_DEMO_URL} label={BOOK_DEMO_LABEL} variant="primary" />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ VOLUME CALLOUT ============ -->
  <section class="band band-ink volume-band">
    <div class="wrap">
      <div class="volume-panel signature-gradient" data-anim data-reveal>
        <div class="volume-copy">
          <h2 class="h2 on-dark volume-h2">Multiple environments, regions, or a managed rollout?</h2>
          <p class="volume-p">We’ll build a plan around your deployment topology, volume, SLA, and data-residency needs.</p>
        </div>
        <Button href={TALK_TO_SALES_URL} label={TALK_TO_SALES_LABEL} variant="white" size="lg" />
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="band band-off">
    <div class="wrap wrap-tight">
      <h2 class="h2 center-h2" data-reveal>Deployment questions</h2>
      <div class="faq" data-reveal>
        {
          faqs.map((f, i) => (
            <div class:list={["faq-item", i === 0 && "open"]}>
              <button class="faq-q" type="button" aria-expanded={i === 0 ? "true" : "false"}>
                <span>{f.q}</span>
                <span class="faq-sign" aria-hidden="true">{i === 0 ? "–" : "+"}</span>
              </button>
              <div class="faq-a"><p>{f.a}</p></div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ CLOSE ============ -->
  <FinalCta
    heading="Book a demo today."
    trustLine={["Runs in your cloud", "Your data never leaves", "Out of PCI scope", "DPA available"]}
  />
</Layout>

<style>
  /* ── Header — the mono "// features" identity (no pill here) ──────── */
  .header { position: relative; background: var(--ink); overflow: hidden; }
  .header-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(100% 80% at 50% -10%, color-mix(in srgb, var(--violet) 28%, transparent), transparent 55%);
  }
  .header-wrap {
    padding-top: clamp(56px, 8vw, 96px);
    padding-bottom: clamp(48px, 6vw, 72px);
    text-align: center;
    z-index: 1;
  }
  .header-eyebrow { display: flex; justify-content: center; margin-bottom: 16px; font-size: 14px; }
  .header-lead {
    font-size: clamp(16px, 1.8vw, 19px);
    line-height: 1.6;
    color: var(--text-dark-body);
    margin: 18px auto 0;
    max-width: 600px;
  }
  .header-cta { justify-content: center; margin-top: 30px; }

  /* ── Capability atlas bento — 5 cells, exactly as many as we have ─── */
  .atlas {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 16px;
  }
  .cell {
    grid-column: span 2;
    background: var(--white);
    border: 1px solid var(--border-light);
    border-radius: 16px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .cell.wide {
    grid-column: span 4;
    background: var(--ink);
    border-color: transparent;
    color: var(--white);
  }
  .cell.tint {
    background: color-mix(in srgb, var(--violet) 5%, var(--white));
    border-color: color-mix(in srgb, var(--violet) 22%, transparent);
  }
  .cell .glyph { margin-bottom: 18px; }
  .cell-t { font-family: var(--font-display); font-weight: 700; font-size: 19px; margin: 0 0 8px; }
  .cell-d { font-size: 14.5px; line-height: 1.55; color: var(--text-light-body); margin: 0; }
  .cell.wide .cell-d { color: var(--text-dark-muted); max-width: 46ch; }
  .cell-code {
    margin: 22px 0 0;
    align-self: stretch;
    background: var(--ink-black);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 12px;
    padding: 16px 18px;
    font-size: 12.5px;
    line-height: 1.9;
    overflow-x: auto;
    white-space: pre;
    color: var(--code-fg);
  }
  .cell-code .v-get { color: var(--cyan); font-weight: 700; }
  .cell-code .v-post { color: var(--lime); font-weight: 700; }
  .cell-code .cm { color: var(--code-punct); }
  @media (max-width: 860px) {
    .atlas { grid-template-columns: 1fr; }
    .cell, .cell.wide { grid-column: span 1; }
  }

  /* ── Deployment options — horizontal rows (Home owns the cards) ───── */
  .deploy { position: relative; }
  .deploy-bg {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: radial-gradient(80% 70% at 12% 0%, color-mix(in srgb, var(--violet) 18%, transparent), transparent 60%);
  }
  .deploy .wrap { z-index: 1; }
  .deploy-rows { display: flex; flex-direction: column; gap: 14px; }
  .deploy-row {
    display: grid;
    grid-template-columns: 1.15fr 1fr;
    gap: 28px;
    align-items: center;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 16px;
    padding: 26px 28px;
  }
  .deploy-row.highlight {
    border-color: color-mix(in srgb, var(--violet) 60%, transparent);
    box-shadow: var(--shadow-popular);
  }
  .deploy-chip {
    display: inline-flex;
    font-family: var(--font-mono);
    font-size: 11.5px;
    font-weight: 500;
    color: var(--text-dark-muted);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.12);
    padding: 4px 10px;
    border-radius: 999px;
    margin-bottom: 12px;
    letter-spacing: 0.02em;
  }
  .deploy-row.highlight .deploy-chip {
    color: var(--ink);
    background: var(--lime);
    border-color: var(--lime);
    font-weight: 700;
  }
  .deploy-name { font-family: var(--font-display); font-weight: 700; font-size: 21px; letter-spacing: -0.02em; color: var(--white); margin: 0 0 8px; }
  .deploy-text { font-size: 14.5px; line-height: 1.55; color: var(--text-dark-muted); margin: 0; }
  .deploy-checks { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  .deploy-checks li { display: flex; gap: 10px; font-size: 14px; color: var(--text-dark-body); }
  .check { flex: none; font-weight: 700; color: var(--lime); }
  .deploy-cta { margin-top: 28px; }
  @media (max-width: 820px) {
    .deploy-row { grid-template-columns: 1fr; gap: 18px; }
  }

  /* ── Comparison table ─────────────────────────────────────────────── */
  .center-h2 { text-align: center; margin-bottom: 36px; }
  .cmp { overflow-x: auto; border: 1px solid var(--border-light); border-radius: 16px; background: var(--white); }
  .cmp table { width: 100%; min-width: 720px; border-collapse: collapse; font-size: 14px; }
  .cmp thead tr { background: var(--off-white); }
  .cmp th {
    text-align: center;
    padding: 18px 16px;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 15px;
    color: var(--ink);
  }
  .cmp th.feature-col { text-align: left; font-family: var(--font-sans); font-weight: 600; color: var(--text-light-muted); font-size: 13px; }
  .cmp th.growth-col { color: var(--violet); }
  .cmp td { padding: 15px 16px; border-top: 1px solid var(--border-light-2); }
  .cmp td.feature-cell { text-align: left; color: var(--text-light-body-strong); font-weight: 500; }
  .cmp td.c { text-align: center; }
  .cmp .ck { color: var(--check-green); font-weight: 700; }
  .cmp .dash { color: var(--text-dark-soft); }
  .cmp .txt { color: var(--ink); font-weight: 600; font-size: 13.5px; }

  /* ── POC callout ──────────────────────────────────────────────────── */
  .poc {
    border: 1px dashed color-mix(in srgb, var(--violet) 45%, transparent);
    background: color-mix(in srgb, var(--violet) 4%, transparent);
    border-radius: 20px;
    padding: clamp(28px, 4vw, 44px);
    text-align: center;
  }
  .poc-eyebrow, .poc-tag {
    display: block;
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--violet);
    margin-bottom: 12px;
  }
  .poc-h2 { margin: 0 0 12px; font-size: clamp(24px, 3.4vw, 34px); }
  .poc-p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-light-body);
    margin: 0 auto 24px;
    max-width: 560px;
  }
  .poc-cta { justify-content: center; }

  /* ── Volume callout ───────────────────────────────────────────────── */
  .volume-panel {
    position: relative;
    overflow: hidden;
    border-radius: 20px;
    padding: clamp(32px, 5vw, 56px);
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: center;
    justify-content: space-between;
  }
  .volume-copy { max-width: 620px; }
  .volume-h2 { margin: 0 0 10px; font-size: clamp(24px, 3.4vw, 36px); letter-spacing: -0.02em; }
  .volume-p { font-size: 16.5px; line-height: 1.55; color: rgba(255, 255, 255, 0.85); margin: 0; }

  /* ── FAQ ──────────────────────────────────────────────────────────── */
  .faq { display: flex; flex-direction: column; gap: 12px; }
  .faq-item { background: var(--white); border: 1px solid var(--border-light); border-radius: 14px; overflow: hidden; }
  .faq-q {
    width: 100%;
    text-align: left;
    background: transparent;
    border: 0;
    cursor: pointer;
    padding: 20px 22px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
  }
  .faq-sign { flex: none; font-family: var(--font-display); font-weight: 700; font-size: 22px; color: var(--violet); line-height: 1; }
  .faq-a { padding: 0 22px 22px; }
  .faq-a p { margin: 0; font-size: 15px; line-height: 1.6; color: var(--text-light-body); }
  /* No-JS: all answers visible. JS on: only .open items show their answer. */
  .faq[data-js="on"] .faq-item:not(.open) .faq-a { display: none; }
</style>

<script>
  // FAQ accordion — single-open, first open by default. (No-JS: all answers show.)
  const faq = document.querySelector<HTMLElement>(".faq");
  if (faq) {
    faq.dataset.js = "on";
    const items = Array.from(faq.querySelectorAll<HTMLElement>(".faq-item"));
    items.forEach((item) => {
      const btn = item.querySelector<HTMLButtonElement>(".faq-q");
      btn?.addEventListener("click", () => {
        const willOpen = !item.classList.contains("open");
        items.forEach((other) => {
          const isThis = other === item && willOpen;
          other.classList.toggle("open", isThis);
          other.querySelector(".faq-q")?.setAttribute("aria-expanded", String(isThis));
          const s = other.querySelector<HTMLElement>(".faq-sign");
          if (s) s.textContent = isThis ? "–" : "+";
        });
      });
    });
  }
</script>
