---
import {
  CONTACT_PATH,
  HOME_PATH,
  PRODUCT_PATH,
  PRIVACY_PATH,
  API_CONTACT_PATH,
  BOOK_DEMO_LABEL,
  TALK_TO_SALES_LABEL,
} from "../lib/site";

/**
 * Contact form card. Intent-driven (demo | sales) + progressive enhancement:
 *  - Native: <form> POSTs to /api/contact; the endpoint 303-redirects back with
 *    ?sent=1 / ?error=1 (preserving &intent=) and the (SSR) page re-renders the
 *    matching pane. Works fully without JS.
 *  - Enhanced: a tiny script intercepts submit, fetches with Accept: json, and
 *    swaps to the success pane inline — no navigation.
 * Server-side validation + Slack delivery live in src/pages/api/contact.ts.
 */
interface Props {
  intent?: "demo" | "sales";
  submitted?: boolean;
  error?: string;
}
const { intent = "demo", submitted = false, error } = Astro.props;

const sales = intent === "sales";
// The switch link always points at the *other* journey.
const switchHref = `${CONTACT_PATH}?intent=${sales ? "demo" : "sales"}`;
const switchLabel = sales
  ? `Want to see it live first? ${BOOK_DEMO_LABEL} →`
  : `Ready to talk pricing & deployment? ${TALK_TO_SALES_LABEL} →`;
const messageLabel = sales ? "Anything we should know?" : "What would you like to see?";
const messagePlaceholder = sales
  ? "Volumes, regions, timelines, current provider…"
  : "Your stack, data licenses, deployment target, timelines…";
const submitLabel = sales ? "Request pricing" : BOOK_DEMO_LABEL;
const successTitle = "Request received.";
const successBody = sales
  ? "Thanks — a solutions engineer will reach out within one business day to scope deployment and pricing."
  : "Thanks — a solutions engineer will reach out within one business day to schedule your walkthrough.";
---

<div class="form-card">
  <div class="glow-border" aria-hidden="true"></div>
  <div class="form-inner">
    <div class="form-pane" data-form hidden={submitted}>
      <form method="POST" action={API_CONTACT_PATH} data-contact-form>
        <input type="hidden" name="intent" value={intent} />

        <div class="name-grid">
          <div class="field">
            <label for="name">Full name</label>
            <input id="name" name="name" type="text" required autocomplete="name" placeholder="Ada Lovelace" />
          </div>
          <div class="field">
            <label for="email">Work email</label>
            <input id="email" name="email" type="email" required autocomplete="email" placeholder="ada@platform.com" />
          </div>
        </div>

        <div class="field">
          <label for="company">Company</label>
          <input id="company" name="company" type="text" required autocomplete="organization" placeholder="Your platform or company" />
        </div>

        <div class="field">
          <label for="role">Your role <span class="optional">(optional)</span></label>
          <input id="role" name="role" type="text" placeholder="e.g. Head of Payments, Staff Engineer" />
        </div>

        <div class="field">
          <label for="volume">Deployment preference</label>
          <select id="volume" name="volume">
            <option>Not sure yet</option>
            <option>Self-hosted / BYOC</option>
            <option>Managed in our cloud</option>
            <option>Fully managed (BYOL)</option>
          </select>
        </div>

        <div class="field">
          <label for="message">{messageLabel} <span class="optional">(optional)</span></label>
          <textarea id="message" name="message" rows="3" placeholder={messagePlaceholder}></textarea>
        </div>

        {/* honeypot — must stay empty; hidden from users + assistive tech */}
        <div class="hp" aria-hidden="true">
          <label for="website">Website</label>
          <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
        </div>

        <div class="err" data-err hidden={!error} role="alert">{error}</div>

        <button type="submit" class="submit" data-submit>{submitLabel}</button>

        <p class="privacy">
          By submitting you agree to our <a href={PRIVACY_PATH}>Privacy Policy</a>. We never store full card numbers.
        </p>

        <div class="switch-row">
          <a class="switch" href={switchHref}>{switchLabel}</a>
        </div>
      </form>
    </div>

    <div class="success-pane" data-success hidden={!submitted}>
      <div class="check" aria-hidden="true">✓</div>
      <h2>{successTitle}</h2>
      <p>{successBody}</p>
      <div class="success-cta-row">
        <a href={HOME_PATH} class="cta-lime">Back to home</a>
        <a href={PRODUCT_PATH} class="cta-ghost">Explore the product</a>
      </div>
    </div>
  </div>
</div>

<style>
  .form-card {
    position: relative;
  }
  /* Soft violet→cyan gradient halo behind the card (matches the prototype). */
  .glow-border {
    position: absolute;
    inset: -1px;
    border-radius: 20px;
    background: linear-gradient(140deg, color-mix(in srgb, var(--violet) 50%, transparent), color-mix(in srgb, var(--cyan) 32%, transparent), color-mix(in srgb, var(--violet) 8%, transparent));
    filter: blur(2px);
    opacity: 0.55;
    pointer-events: none;
  }
  .form-inner {
    position: relative;
    background: var(--ink-2);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 18px;
    padding: clamp(24px, 3vw, 36px);
    box-shadow: var(--shadow-panel);
  }

  form { display: flex; flex-direction: column; gap: 18px; }
  .name-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  @media (max-width: 520px) { .name-grid { grid-template-columns: 1fr; } }

  .field { display: flex; flex-direction: column; gap: 7px; }
  label {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-dark-soft);
  }
  .optional { color: var(--text-dark-faint); font-weight: 400; }

  input,
  select,
  textarea {
    width: 100%;
    font-family: var(--font-sans);
    font-size: 15px;
    color: var(--white);
    background: var(--ink-3);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 12px 14px;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  select { appearance: none; cursor: pointer; }
  textarea { resize: vertical; }
  input::placeholder,
  textarea::placeholder { color: var(--text-dark-faint); }
  input:focus,
  select:focus,
  textarea:focus {
    outline: none;
    border-color: var(--violet);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--violet) 18%, transparent);
  }

  /* honeypot: visually + AT hidden, but not display:none (some bots skip those) */
  .hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }

  .err {
    font-size: 13px;
    color: var(--error);
    background: color-mix(in srgb, var(--error) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--error) 30%, transparent);
    border-radius: 9px;
    padding: 0.6rem 0.8rem;
  }

  .submit {
    width: 100%;
    border: 0;
    cursor: pointer;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 16px;
    color: var(--ink);
    background: var(--lime);
    padding: 15px;
    border-radius: 11px;
    box-shadow: var(--shadow-lime);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }
  .submit:hover { transform: translateY(-1px); }
  .submit[disabled] { opacity: 0.7; cursor: progress; transform: none; }

  .privacy {
    margin: 2px 0 0;
    font-size: 12.5px;
    line-height: 1.55;
    color: var(--text-light-muted);
    text-align: center;
  }
  .privacy a { color: var(--text-dark-muted); text-decoration: underline; }

  .switch-row {
    text-align: center;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    padding-top: 18px;
    margin-top: 2px;
  }
  .switch {
    font-size: 14px;
    font-weight: 500;
    color: var(--text-dark-muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .switch:hover { color: var(--cyan); }

  /* Success pane */
  .success-pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0;
    padding: 24px 8px;
  }
  .check {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--lime) 14%, transparent);
    border: 1px solid color-mix(in srgb, var(--lime) 40%, transparent);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--lime);
    font-size: 30px;
    line-height: 1;
    margin-bottom: 22px;
  }
  .success-pane h2 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    letter-spacing: -0.02em;
    margin: 0 0 12px;
  }
  .success-pane p {
    font-size: 15.5px;
    line-height: 1.6;
    color: var(--text-dark-body);
    margin: 0 auto 26px;
    max-width: 38ch;
  }
  .success-cta-row { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  .cta-lime,
  .cta-ghost {
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    padding: 12px 22px;
    border-radius: 11px;
    transition: transform 0.15s ease, background 0.15s ease, border-color 0.15s ease;
  }
  .cta-lime { color: var(--ink); background: var(--lime); }
  .cta-lime:hover { transform: translateY(-1px); }
  .cta-ghost {
    color: var(--white);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.16);
  }
  .cta-ghost:hover { background: rgba(255, 255, 255, 0.1); border-color: rgba(255, 255, 255, 0.28); }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>("[data-contact-form]");
  if (form) {
    form.addEventListener("submit", async (e) => {
      // Native HTML5 validation (required/type=email) runs before this fires.
      e.preventDefault();
      const card = form.closest(".form-card")!;
      const errEl = form.querySelector<HTMLElement>("[data-err]")!;
      const btn = form.querySelector<HTMLButtonElement>("[data-submit]")!;
      const formPane = card.querySelector<HTMLElement>("[data-form]")!;
      const successPane = card.querySelector<HTMLElement>("[data-success]")!;
      btn.disabled = true;
      const label = btn.textContent;
      btn.textContent = "Sending…";
      errEl.hidden = true;
      try {
        const res = await fetch(form.action, {
          method: "POST",
          body: new FormData(form),
          headers: { Accept: "application/json" },
        });
        const data = (await res.json().catch(() => ({ ok: res.ok }))) as {
          ok?: boolean;
          error?: string;
        };
        if (res.ok && data.ok !== false) {
          formPane.hidden = true;
          successPane.hidden = false;
          successPane.scrollIntoView({ block: "nearest" });
          return;
        }
        errEl.textContent = data.error || "Something went wrong. Please try again.";
      } catch {
        errEl.textContent = "Network error. Please try again.";
      }
      errEl.hidden = false;
      btn.disabled = false;
      btn.textContent = label;
    });
  }
</script>
