---
import Wordmark from "./Wordmark.astro";
import {
  HOME_PATH,
  PRODUCT_PATH,
  FEATURES_PATH,
  PRIVACY_PATH,
  TERMS_PATH,
  DPA_PATH,
  GDPR_PATH,
} from "../lib/site";

const productLinks = [
  { href: PRODUCT_PATH, label: "Overview" },
  { href: `${HOME_PATH}#try`, label: "Try it live" },
  { href: FEATURES_PATH, label: "Features" },
  { href: `${HOME_PATH}#deployment`, label: "Deployment models" },
];
const legalLinks = [
  { href: PRIVACY_PATH, label: "Privacy" },
  { href: TERMS_PATH, label: "Terms" },
  { href: DPA_PATH, label: "DPA" },
  { href: GDPR_PATH, label: "GDPR" },
];
---

<footer id="footer" class="site-footer">
  <div class="footer-wrap">
    <div class="footer-grid">
      <div class="brand">
        <Wordmark size={24} class="footer-wordmark" />
        <p class="mission">
          The BIN intelligence engine for payment platforms. Deploy it in your own cloud; your data never leaves.
        </p>
        <div class="eu-pill">
          <span class="dot" aria-hidden="true"></span>
          <span>Runs in your cloud · EU option</span>
        </div>
      </div>

      <div class="col">
        <h2>Product</h2>
        <ul>{productLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
      <div class="col">
        <h2>Legal</h2>
        <ul>{legalLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="copyright">© 2026 FindThisBIN. All rights reserved.</span>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink-4);
    border-top: 1px solid rgba(255, 255, 255, 0.07);
    color: var(--text-dark-muted);
  }
  .footer-wrap {
    max-width: 1240px;
    margin: 0 auto;
    padding: 64px 24px 40px;
  }
  .footer-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 40px 32px;
  }
  .brand { min-width: 200px; }
  .footer-wordmark { margin-bottom: 18px; }
  .mission {
    margin: 0 0 20px;
    font-size: 14px;
    line-height: 1.6;
    color: var(--text-dark-muted-2);
    max-width: 280px;
  }
  .eu-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 7px 12px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--cyan) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--cyan) 22%, transparent);
    font-size: 12.5px;
    font-weight: 600;
    color: var(--cyan);
    letter-spacing: 0.02em;
  }
  .eu-pill .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--cyan);
    box-shadow: 0 0 8px var(--cyan);
  }

  .col h2 {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-dark-faint);
    margin: 0 0 16px;
  }
  .col ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 11px;
  }
  .col a {
    color: var(--text-dark-muted);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s ease;
  }
  .col a:hover {
    color: var(--white);
  }

  .footer-bottom {
    margin-top: 52px;
    padding-top: 26px;
    border-top: 1px solid rgba(255, 255, 255, 0.07);
  }
  .copyright {
    font-size: 13px;
    color: var(--text-dark-faint);
  }

  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 520px) {
    .footer-grid { gap: 32px 20px; }
  }
</style>
