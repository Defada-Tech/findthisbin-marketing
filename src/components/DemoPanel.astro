---
/**
 * Hero "deployment" demo panel: a deployment motif (your licensed sources →
 * the engine → your API, all inside *your* cloud) above the canonical BIN
 * response. Each JSON line fades up staggered (ftbUp + increasing delay) with a
 * blinking lime caret on the close brace. The request host is bins.internal to
 * signal self-hosting. Scheme-coverage strip uses plain text (no trademarked
 * logos).
 */
import { ENGINE_BASE_URL } from "../lib/site";

const schemes = ["VISA", "Mastercard", "AMEX", "Discover", "JCB", "UnionPay"];
const sources = ["VBASS", "Mastercard", "CSV"];
const requestUrl = `${ENGINE_BASE_URL}/v1/bins/`;
---

<div class="demo">
  <div class="glow-border">
    <div class="panel">
      <div class="head">
        <span class="lights" aria-hidden="true"><span></span><span></span><span></span></span>
        <span class="head-label mono">findthisbin-engine · your-cloud</span>
      </div>

      <div class="cloud">
        <div class="cloud-head">
          <span class="cloud-region mono">your cloud · eu-west-1 · vpc</span>
          <span class="cloud-note mono">data stays here</span>
        </div>
        <div class="flow">
          <div class="sources">
            {sources.map((s) => <span class="src mono">{s}</span>)}
          </div>
          <span class="arrow" aria-hidden="true">→</span>
          <div class="engine">
            <span class="engine-name">FindThisBIN engine</span>
            <span class="engine-sub mono">8-digit · multi-source merge</span>
          </div>
          <span class="arrow" aria-hidden="true">→</span>
          <span class="output mono">your API</span>
        </div>
      </div>

      <div class="req mono">
        <span class="verb">GET</span>
        <span class="url">{requestUrl}<span class="bin">53847012</span></span>
      </div>

      <pre class="body mono" aria-label="Example API response"><code>{
<span class="ln" style="animation-delay:.05s"><span class="k">"bin"</span><span class="p">:</span> <span class="s">"53847012"</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.10s"><span class="k">"scheme"</span><span class="p">:</span> <span class="s">"mastercard"</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.16s"><span class="k">"type"</span><span class="p">:</span> <span class="s">"credit"</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.22s"><span class="k">"category"</span><span class="p">:</span> <span class="s">"consumer"</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.28s"><span class="k">"product"</span><span class="p">:</span> <span class="s">"World Elite Mastercard"</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.36s"><span class="k">"issuer"</span><span class="p">:</span> <span class="p">{</span> <span class="k">"name"</span><span class="p">:</span> <span class="s">"Revolut Ltd"</span><span class="p">,</span> <span class="k">"country"</span><span class="p">:</span> <span class="s">"GB"</span><span class="p">,</span> <span class="k">"currency"</span><span class="p">:</span> <span class="s">"GBP"</span> <span class="p">}</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.46s"><span class="k">"flags"</span><span class="p">:</span> <span class="p">{</span> <span class="k">"prepaid"</span><span class="p">:</span> <span class="n">false</span><span class="p">,</span> <span class="k">"commercial"</span><span class="p">:</span> <span class="n">false</span><span class="p">,</span> <span class="k">"regulated_debit"</span><span class="p">:</span> <span class="n">false</span> <span class="p">}</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.56s"><span class="k">"dcc_eligible"</span><span class="p">:</span> <span class="n">true</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.64s"><span class="k">"confidence"</span><span class="p">:</span> <span class="n">0.98</span><span class="p">,</span></span>
<span class="ln" style="animation-delay:.72s"><span class="k">"dataset_version"</span><span class="p">:</span> <span class="s">"2026-06-12"</span></span>
}<span class="caret" aria-hidden="true"></span></code></pre>

      <div class="schemes">
        <span class="schemes-label">Coverage across every major scheme</span>
        <div class="scheme-row">
          {schemes.map((s) => <span class="scheme mono">{s}</span>)}
        </div>
      </div>
    </div>
  </div>
</div>

<style>
  .demo { position: relative; z-index: 1; }
  .glow-border {
    border-radius: 18px;
    padding: 1px;
    background: linear-gradient(135deg, color-mix(in srgb, var(--violet) 70%, transparent), color-mix(in srgb, var(--cyan) 40%, transparent), transparent 70%);
    box-shadow: var(--shadow-panel);
  }
  .panel {
    background: var(--ink-2);
    border-radius: 17px;
    overflow: hidden;
  }
  .head {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    background: var(--ink-soft);
    border-bottom: 1px solid var(--border-dark);
  }
  .lights { display: inline-flex; gap: 6px; }
  .lights span { width: 11px; height: 11px; border-radius: 50%; }
  .lights span:nth-child(1) { background: var(--chrome-close); }
  .lights span:nth-child(2) { background: var(--chrome-min); }
  .lights span:nth-child(3) { background: var(--chrome-max); }
  .head-label { font-size: 12.5px; color: var(--text-dark-muted); }

  /* Deployment motif — the "your cloud" box */
  .cloud {
    margin: 16px 16px 4px;
    padding: 12px 14px 14px;
    border: 1px dashed color-mix(in srgb, var(--violet) 40%, transparent);
    border-radius: 12px;
    background: color-mix(in srgb, var(--violet) 5%, transparent);
  }
  .cloud-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    margin-bottom: 12px;
  }
  .cloud-region { font-size: 11px; color: var(--cyan); letter-spacing: 0.02em; }
  .cloud-note { font-size: 11px; color: var(--text-dark-faint); }
  .flow {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
  }
  .sources { display: inline-flex; flex-direction: column; gap: 5px; }
  .src {
    font-size: 11px;
    color: var(--text-dark-muted);
    background: var(--ink-3);
    border: 1px solid var(--border-dark);
    border-radius: 6px;
    padding: 3px 8px;
    text-align: center;
  }
  .arrow { color: var(--text-dark-faint); font-size: 14px; }
  .engine {
    display: inline-flex;
    flex-direction: column;
    gap: 2px;
    background: var(--ink-3);
    border: 1px solid color-mix(in srgb, var(--violet) 50%, transparent);
    border-radius: 9px;
    padding: 9px 12px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--violet) 8%, transparent);
  }
  .engine-name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 13px;
    color: var(--white);
  }
  .engine-sub { font-size: 10.5px; color: var(--text-dark-faint); }
  .output {
    font-size: 11.5px;
    font-weight: 500;
    color: var(--lime);
    background: color-mix(in srgb, var(--lime) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--lime) 35%, transparent);
    border-radius: 6px;
    padding: 6px 10px;
  }

  .req {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    padding: 14px 18px;
    font-size: 13px;
    border-bottom: 1px solid var(--border-dark);
    color: var(--text-dark-body);
    word-break: break-all;
  }
  .verb {
    font-weight: 700;
    color: var(--ink);
    background: var(--lime);
    padding: 2px 9px;
    border-radius: 6px;
    font-size: 12px;
  }
  .bin { color: var(--cyan); }

  .body {
    margin: 0;
    padding: 18px;
    font-size: 12.5px;
    line-height: 1.8;
    color: var(--code-fg);
    overflow-x: auto;
    white-space: pre;
  }
  .body .ln {
    display: inline-block;
    width: 100%;
    padding-left: 1.4em;
    animation: ftbUp 0.4s ease both;
  }
  .k { color: var(--code-key); }
  .s { color: var(--code-string); }
  .n { color: var(--code-number); }
  .p { color: var(--code-punct); }
  .caret {
    display: inline-block;
    width: 8px;
    height: 1.05em;
    margin-left: 4px;
    vertical-align: text-bottom;
    background: var(--lime);
    animation: ftbBlink 1s step-end infinite;
  }

  .schemes {
    padding: 16px 18px 18px;
    border-top: 1px solid var(--border-dark);
  }
  .schemes-label {
    display: block;
    font-size: 11.5px;
    color: var(--text-dark-faint);
    margin-bottom: 10px;
  }
  .scheme-row {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
  }
  .scheme {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--text-dark-soft);
    filter: grayscale(1);
    opacity: 0.62;
  }

  @media (prefers-reduced-motion: reduce) {
    .body .ln { animation: none; }
    .caret { animation: none; }
  }
</style>
